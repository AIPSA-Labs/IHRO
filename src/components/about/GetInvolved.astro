---
//- About page Get Involved CTA section with gradient background and multicolor strip
import { translations } from "../../locals/about/getInvolved";
import { HeartHandshake } from "@lucide/astro";

type Locale = "en" | "hi" | "fr";
const { local = "en" } = Astro.params ?? {};
const t = translations[local as Locale] || translations["en"];
---

<section class="relative py-24 px-4 md:px-8 bg-gradient-to-br from-blue-900 via-blue-900 to-blue-800 text-white overflow-hidden">
  <div class="max-w-4xl mx-auto text-center relative z-10">

    <h2 class="animate-on-scroll font-['Hanken_Grotesk'] text-4xl md:text-5xl font-bold mb-6 tracking-tight text-white">
      {t.title}
    </h2>

    <p class="animate-on-scroll delay-1 font-['Inter'] text-lg text-blue-100 mb-10 max-w-2xl mx-auto leading-relaxed">
      {t.subtitle}
    </p>

    <div class="animate-on-scroll delay-2 flex flex-wrap justify-center gap-4">
      <a
        href={`/${local}/contact`}
        class="inline-flex items-center gap-2 bg-yellow-500 text-gray-900 font-semibold px-8 py-3.5 rounded-lg hover:bg-yellow-400 transition-all text-sm shadow-lg active:scale-95 cursor-pointer"
      >
        <HeartHandshake class="w-5 h-5 text-gray-900" />
        <span>{t.cta.volunteer}</span>
      </a>

      <a
        href={`/${local}/contact`}
        class="inline-flex items-center gap-2 bg-white/10 border border-white/20 text-white font-semibold px-8 py-3.5 rounded-lg hover:bg-white hover:text-blue-900 transition-all text-sm shadow-sm active:scale-95 cursor-pointer"
      >
        <span>Contact Us</span>
        <span class="material-symbols-outlined text-base">arrow_forward</span>
      </a>
    </div>

  </div>

  {/*- Multicolor bar divider at section bottom */}
  <div class="colored-bar absolute bottom-0 left-0 right-0">
    <span></span><span></span><span></span><span></span><span></span>
  </div>
</section>
