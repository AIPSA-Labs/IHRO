---
//- Impact section with white background and 4 multicolor metric cards
import { translations } from "../../locals/about/impact";
import { TrendingUp, Award, Users, Globe } from "@lucide/astro";

type Locale = "en" | "hi" | "fr";
const { local = "en" } = Astro.params ?? {};
const t = translations[local as Locale] || translations["en"];

const STAT_CONFIGS = [
  { icon: TrendingUp, iconColor: "text-blue-800", iconBg: "bg-blue-50", numColor: "text-blue-900", borderHover: "hover:border-blue-700" },
  { icon: Award,      iconColor: "text-red-600",  iconBg: "bg-red-50",  numColor: "text-red-600",  borderHover: "hover:border-red-600" },
  { icon: Users,      iconColor: "text-green-700", iconBg: "bg-green-50", numColor: "text-green-700", borderHover: "hover:border-green-700" },
  { icon: Globe,      iconColor: "text-yellow-600", iconBg: "bg-yellow-50", numColor: "text-yellow-600", borderHover: "hover:border-yellow-500" },
];
---

<section class="bg-gray-50 py-24 px-4 md:px-8 border-b border-gray-100 relative overflow-hidden">
  <div class="max-w-7xl mx-auto">

    {/*- Section header */}
    <div class="text-center mb-16">
      <h2 class="animate-on-scroll font-['Hanken_Grotesk'] text-4xl font-bold text-blue-900 mb-4">
        {t.title}
      </h2>
      <p class="animate-on-scroll delay-1 font-['Inter'] text-gray-500 text-base max-w-xl mx-auto">
        {t.subtitle}
      </p>
    </div>

    {/*- 4 Stat Cards */}
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      {t.stats.map((stat, index) => {
        const config = STAT_CONFIGS[index % STAT_CONFIGS.length];
        const IconComponent = config.icon;

        return (
          <div class={`bg-white rounded-xl sm:rounded-2xl p-6 sm:p-8 border border-gray-200 shadow-sm hover:shadow-lg transition-all duration-200 flex flex-col items-center text-center ${config.borderHover}`}>
            <div class={`w-14 h-14 rounded-xl flex items-center justify-center mb-6 ${config.iconBg} ${config.iconColor}`}>
              <IconComponent class="w-7 h-7" />
            </div>
            <p class={`font-['Hanken_Grotesk'] text-4xl md:text-5xl font-extrabold mb-2 tracking-tight ${config.numColor}`}>
              {stat.number}
            </p>
            <p class="font-['Inter'] text-sm font-semibold text-gray-600 uppercase tracking-wider">
              {stat.label}
            </p>
          </div>
        );
      })}
    </div>

  </div>
</section>
