---
//- "Our Upcoming Events" section featuring 3 vertical photo cards with floating coral date badges and dark gradient overlays

import { getStrings } from "../../constants/strings";

const { local = "en" } = Astro.params;
const s = getStrings(local);

const DELAYS = ["delay-100", "delay-200", "delay-300"];
---

<section class="py-20 md:py-28 bg-gray-50 text-zinc-900 border-b border-gray-100 w-full" id="events">
  <div class="w-full max-w-screen-2xl mx-auto px-6 sm:px-10 lg:px-16 xl:px-20">
    
    {/*- Section Header */}
    <div class="text-center max-w-2xl mx-auto mb-14 md:mb-18 animate-on-scroll">
      <h2 class="font-['Newsreader'] text-3xl sm:text-4xl md:text-5xl font-bold tracking-tight text-zinc-900 mb-4">
        {s.events.title}
      </h2>
      <p class="font-['Inter'] text-sm sm:text-base text-zinc-600 font-normal">
        {s.events.subtitle}
      </p>
    </div>

    {/*- 3 Vertical Event Cards */}
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {s.events.items.map((event, idx) => (
        <div class={`relative aspect-[3/4] rounded-2xl overflow-hidden shadow-md group border border-gray-100 flex flex-col justify-between p-6 bg-charcoal-dark animate-on-scroll ${DELAYS[idx % 3]}`}>
          {/*- Photographic Background */}
          <img
            src={event.image}
            alt={event.title}
            class="absolute inset-0 w-full h-full object-cover"
            loading="lazy"
          />

          {/*- Deep Dark Gradient Overlay */}
          <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/40 to-black/20"></div>

          {/*- Top Row: Floating Coral Date Badge */}
          <div class="relative z-10 flex justify-end">
            <div class="bg-coral text-white rounded-xl px-3.5 py-2 text-center shadow-md">
              <span class="block text-[10px] font-bold uppercase tracking-wider leading-none">
                {event.month}
              </span>
              <span class="block font-['Cinzel'] text-xl font-bold leading-tight mt-0.5">
                {event.day}
              </span>
            </div>
          </div>

          {/*- Bottom Content */}
          <div class="relative z-10">
            <h3 class="font-['Newsreader'] text-2xl font-bold text-white leading-snug mb-2 group-hover:text-coral transition-colors">
              {event.title}
            </h3>
            <p class="font-['Inter'] text-xs sm:text-sm text-zinc-300 mb-4 flex items-center gap-1.5">
              <span class="material-symbols-outlined text-sm text-coral">location_on</span>
              <span>{event.location}</span>
            </p>
            <a
              href={`/${local}/contact?topic=events`}
              class="inline-flex items-center gap-1.5 text-xs font-bold uppercase tracking-wider text-coral hover:text-white transition-colors"
            >
              <span>{event.cta}</span>
              <span class="material-symbols-outlined text-sm">arrow_forward</span>
            </a>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>
