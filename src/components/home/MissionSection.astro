---
//- Three-pillar institutional charter section with structured editorial frames and crisp dividers
import { getStrings } from "../../constants/strings";

const { local = "en" } = Astro.params;
const s = getStrings(local);
---

<section id="mission" class="relative py-24 md:py-32 bg-canvas text-justice-navy overflow-hidden w-full border-b border-border scroll-mt-20">
  
  <div class="relative w-full max-w-screen-2xl mx-auto px-6 sm:px-10 lg:px-16 xl:px-20">
    
    {/*- Section Header */}
    <div class="text-center max-w-3xl mx-auto mb-16 md:mb-20">
      <h2 class="font-['Newsreader'] text-3xl sm:text-4xl md:text-5xl font-medium tracking-tight text-justice-navy mb-4 leading-tight">
        <span>{s.pillars.sectionTitleLine1}</span>{" "}
        <span class="italic font-normal text-royal-blue">{s.pillars.sectionTitleLine2}</span>
      </h2>
      <p class="font-['Inter'] text-sm sm:text-base text-on-surface-variant leading-relaxed max-w-xl mx-auto">
        {s.pillars.sectionSubtitle}
      </p>
    </div>

    {/*- 3-Column Structured Institutional Dossiers */}
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 relative z-10">
      {s.pillars.cards.map((card, index) => (
        <div class="bg-white border border-border p-7 text-justice-navy flex flex-col justify-between shadow-2xs hover:border-royal-blue transition-colors group">
          <div>
            {/*- Archival Photo Frame */}
            <div class="border border-border/80 overflow-hidden mb-6 aspect-video bg-canvas-muted p-1">
              <img
                src={card.image}
                alt={card.title}
                class="w-full h-full object-cover"
              />
            </div>
            
            {/*- Dossier Number & Title */}
            <div class="flex items-center gap-2 mb-2">
              <span class="font-['Cinzel'] text-[10px] font-bold tracking-widest text-honor-gold uppercase">
                Pillar 0{index + 1}
              </span>
            </div>
            <h3 class="font-['Newsreader'] text-2xl font-semibold text-justice-navy mb-3 tracking-tight group-hover:text-royal-blue transition-colors">
              {card.title}
            </h3>
            <p class="font-['Inter'] text-xs sm:text-sm text-on-surface-variant leading-relaxed">
              {card.description}
            </p>
          </div>

          {/*- Action Link */}
          <div class="mt-8 pt-5 border-t border-border flex items-center justify-between">
            <a
              href={`/${local}/contact?topic=${encodeURIComponent(card.title.toLowerCase())}`}
              class="inline-flex items-center gap-1.5 text-xs font-semibold tracking-wider uppercase text-royal-blue hover:text-justice-navy transition-colors"
            >
              <span>{s.pillars.ctaLabel} {card.title}</span>
              <span class="material-symbols-outlined text-sm">arrow_forward</span>
            </a>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>
