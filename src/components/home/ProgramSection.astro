---
//- Programs section with white background and multicolor themed cards
import { translations } from "../../locals/home/program";

type Locale = "en" | "hi" | "fr";
const { local = "en" } = Astro.params ?? {};
const t = translations[local as Locale] || translations["en"];
---

<section class="py-20 md:py-28 bg-white px-4 md:px-8 border-b border-gray-100" id="programs">
  <div class="max-w-7xl mx-auto">

    {/*- Section header */}
    <div class="mb-14 text-center">
      <h2 class="animate-on-scroll font-['Hanken_Grotesk'] text-4xl md:text-5xl font-bold text-blue-900 mb-4">
        {t.title}
      </h2>
      <p class="animate-on-scroll delay-1 text-gray-500 max-w-xl mx-auto font-['Inter'] text-base">
        {t.subtitle}
      </p>
    </div>

    {/*- Programs grid */}
    <div class="grid grid-cols-1 md:grid-cols-12 gap-6 auto-rows-auto">

      {/*- Program 0: Advocacy — full-width blue card */}
      <div class="animate-on-scroll md:col-span-12 bg-blue-900 text-white rounded-2xl p-8 md:p-12 flex flex-col justify-end relative overflow-hidden group min-h-64 shadow-sm">
        <div class="absolute top-6 right-6 text-white/20 group-hover:text-white/30 transition-colors">
          <span class="material-symbols-outlined text-8xl">{t.programs[0].icon}</span>
        </div>
        <h3 class="font-['Hanken_Grotesk'] text-2xl md:text-3xl font-bold mb-3 relative z-10">
          {t.programs[0].title}
        </h3>
        <p class="text-blue-100 relative z-10 max-w-2xl font-['Inter'] text-base leading-relaxed">
          {t.programs[0].description}
        </p>
      </div>

      {/*- Program 1: Legal Aid — white card, red left border */}
      <div class="animate-on-scroll scroll-left delay-1 md:col-span-3 bg-white border-l-4 border-l-red-600 border-t border-r border-b border-gray-200 rounded-2xl p-8 shadow-sm hover:shadow-md transition-shadow flex flex-col gap-4">
        <div class="w-12 h-12 rounded-xl bg-red-50 text-red-600 flex items-center justify-center">
          <span class="material-symbols-outlined text-3xl">{t.programs[1].icon}</span>
        </div>
        <div>
          <h3 class="font-['Hanken_Grotesk'] text-xl font-bold text-gray-900 mb-2">
            {t.programs[1].title}
          </h3>
          <p class="text-gray-600 text-sm leading-relaxed font-['Inter']">
            {t.programs[1].description}
          </p>
        </div>
      </div>

      {/*- Program 2: Education — white card, green left border */}
      <div class="animate-on-scroll delay-2 md:col-span-3 bg-white border-l-4 border-l-green-700 border-t border-r border-b border-gray-200 rounded-2xl p-8 shadow-sm hover:shadow-md transition-shadow flex flex-col gap-4">
        <div class="w-12 h-12 rounded-xl bg-green-50 text-green-700 flex items-center justify-center">
          <span class="material-symbols-outlined text-3xl">{t.programs[2].icon}</span>
        </div>
        <div>
          <h3 class="font-['Hanken_Grotesk'] text-xl font-bold text-gray-900 mb-2">
            {t.programs[2].title}
          </h3>
          <p class="text-gray-600 text-sm leading-relaxed font-['Inter']">
            {t.programs[2].description}
          </p>
        </div>
      </div>

      {/*- Program 3: Environmental — white card, yellow left border */}
      <div class="animate-on-scroll delay-3 md:col-span-3 bg-white border-l-4 border-l-yellow-500 border-t border-r border-b border-gray-200 rounded-2xl p-8 shadow-sm hover:shadow-md transition-shadow flex flex-col gap-4">
        <div class="w-12 h-12 rounded-xl bg-yellow-50 text-yellow-600 flex items-center justify-center">
          <span class="material-symbols-outlined text-3xl">{t.programs[3].icon}</span>
        </div>
        <div>
          <h3 class="font-['Hanken_Grotesk'] text-xl font-bold text-gray-900 mb-2">
            {t.programs[3].title}
          </h3>
          <p class="text-gray-600 text-sm leading-relaxed font-['Inter']">
            {t.programs[3].description}
          </p>
        </div>
      </div>

      {/*- Program 4: Community — white card, purple left border */}
      <div class="animate-on-scroll scroll-right delay-4 md:col-span-3 bg-white border-l-4 border-l-purple-700 border-t border-r border-b border-gray-200 rounded-2xl p-8 shadow-sm hover:shadow-md transition-shadow flex flex-col gap-4">
        <div class="w-12 h-12 rounded-xl bg-purple-50 text-purple-700 flex items-center justify-center">
          <span class="material-symbols-outlined text-3xl">{t.programs[4].icon}</span>
        </div>
        <div>
          <h3 class="font-['Hanken_Grotesk'] text-xl font-bold text-gray-900 mb-2">
            {t.programs[4].title}
          </h3>
          <p class="text-gray-600 text-sm leading-relaxed font-['Inter']">
            {t.programs[4].description}
          </p>
        </div>
      </div>

    </div>
  </div>
</section>
