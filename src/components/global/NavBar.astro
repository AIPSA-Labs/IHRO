---
//- Dark modern humanitarian navigation bar with IHRO brand, centered links, language dropdown, and coral pill CTA button

import { getStrings } from "../../constants/strings";
import { supportedLocales } from "../../locals/languages";

const { local = "en" } = Astro.params;
const s = getStrings(local);

//- Extract current sub-path without locale prefix so language switcher preserves the active page
const pathname = Astro.url.pathname;
const cleanPath = pathname.replace(/^\/(en|hi|fr)/, '') || '';
---

<header class="fixed top-0 left-0 right-0 z-50 bg-charcoal-dark/95 backdrop-blur-md transition-colors w-full border-b border-white/10 text-white">
  <div class="w-full max-w-screen-2xl mx-auto px-6 sm:px-10 lg:px-16 xl:px-20">
    <div class="flex items-center justify-between h-20">

      {/*- IHRO Brand Identity */}
      <a href={`/${local}/`} class="flex items-center gap-3 cursor-pointer group">
        <div class="w-10 h-10 rounded-full bg-white/10 flex items-center justify-center p-1.5 border border-white/20 group-hover:border-coral transition-colors">
          <img src="/favicon.svg" alt={s.brand.name} class="h-full w-full object-contain" />
        </div>
        <div class="flex flex-col">
          <span class="font-['Cinzel'] text-xl font-bold text-white leading-none tracking-wider group-hover:text-coral transition-colors">
            {s.brand.name}
          </span>
          <span class="hidden sm:inline font-['Inter'] text-[10px] text-zinc-400 uppercase tracking-wider font-medium mt-1">
            {s.brand.fullName}
          </span>
        </div>
      </a>

      {/*- Centered Desktop Navigation */}
      <nav class="hidden lg:flex items-center gap-5 xl:gap-8">
        <a href={`/${local}/`} class="text-xs font-semibold uppercase tracking-wider text-white hover:text-coral transition-colors">
          {s.nav.home}
        </a>
        <a href={`/${local}/about`} class="text-xs font-semibold uppercase tracking-wider text-zinc-300 hover:text-coral transition-colors">
          {s.nav.about}
        </a>
        <a href={`/${local}/#causes`} class="text-xs font-semibold uppercase tracking-wider text-zinc-300 hover:text-coral transition-colors">
          {s.nav.programs}
        </a>
        <a href={`/${local}/#events`} class="text-xs font-semibold uppercase tracking-wider text-zinc-300 hover:text-coral transition-colors">
          {s.nav.events}
        </a>
        <a href={`/${local}/#news`} class="text-xs font-semibold uppercase tracking-wider text-zinc-300 hover:text-coral transition-colors">
          {s.nav.news}
        </a>
        <a href={`/${local}/contact`} class="text-xs font-semibold uppercase tracking-wider text-zinc-300 hover:text-coral transition-colors">
          {s.nav.contact}
        </a>
      </nav>

      {/*- Right Actions: Language Selector and Coral Pill CTA */}
      <div class="flex items-center gap-3">
        {/*- Circular Language Selector Button */}
        <div class="relative">
          <button
            id="navLangButton"
            class="h-9 px-3 rounded-full border border-white/20 bg-white/5 text-white flex items-center gap-1.5 hover:bg-white/10 hover:border-white/40 transition-colors cursor-pointer text-xs font-semibold"
            aria-label={s.nav.language}
          >
            <span class="material-symbols-outlined text-sm">language</span>
            <span>{s.nav.language}</span>
          </button>
          
          <div
            id="navLangMenu"
            class="dropdown-hidden absolute right-0 mt-2 w-36 bg-charcoal-card border border-white/15 rounded-xl shadow-xl py-1.5 z-50 text-white"
          >
            {supportedLocales.map((loc) => (
              <a
                href={`/${loc.code}${cleanPath}`}
                class={`block px-4 py-2 text-xs font-medium transition-colors ${
                  loc.code === local ? 'bg-coral text-white font-semibold' : 'text-zinc-300 hover:bg-white/10 hover:text-white'
                }`}
              >
                {loc.label}
              </a>
            ))}
          </div>
        </div>

        {/*- Terracotta / Coral Pill Action CTA Button */}
        <a
          href={`/${local}/contact?type=donate`}
          class="hidden sm:inline-flex items-center justify-center px-4 lg:px-6 py-2.5 rounded-full bg-coral hover:bg-coral-hover text-white text-xs font-bold uppercase tracking-wider shadow-md transition-all cursor-pointer"
        >
          {s.nav.donateNow}
        </a>

        {/*- Sleek Borderless Drawer Toggle with Staggered Lines */}
        <button
          class="lg:hidden flex flex-col justify-center items-end gap-1.5 p-2 text-white hover:text-coral transition-colors cursor-pointer group"
          onclick="toggleDrawer()"
          aria-label={s.nav.home}
        >
          <span class="w-6 h-0.5 bg-current rounded-full transition-all duration-300"></span>
          <span class="w-3.5 h-0.5 bg-current rounded-full transition-all duration-300 group-hover:w-6"></span>
          <span class="w-5 h-0.5 bg-current rounded-full transition-all duration-300 group-hover:w-6"></span>
        </button>
      </div>

    </div>
  </div>
</header>

<script>
  //- Dropdown toggle for language menu
  const langButton = document.getElementById('navLangButton');
  const langMenu = document.getElementById('navLangMenu');

  if (langButton && langMenu) {
    langButton.addEventListener('click', (e) => {
      e.stopPropagation();
      langMenu.classList.toggle('dropdown-hidden');
    });

    document.addEventListener('click', () => {
      if (!langMenu.classList.contains('dropdown-hidden')) {
        langMenu.classList.add('dropdown-hidden');
      }
    });
  }

  //- Drawer toggle function on window
  // @ts-ignore
  window.toggleDrawer = function() {
    const drawer = document.getElementById('drawer');
    if (drawer) {
      drawer.classList.toggle('-translate-y-full');
      drawer.classList.toggle('translate-y-0');
    }
  };
</script>
