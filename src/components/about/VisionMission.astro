---
import { translations } from "../../locals/about/missionVision";
import { Target, Eye } from "@lucide/astro";

type Locale = 'en' | 'hi' | 'fr';
const { local = 'en' } = Astro.params ?? {};
const t = translations[local as Locale] || translations['en'];
---

<section class="bg-background text-foreground py-24 px-6 sm:px-10 lg:px-16 xl:px-20 relative overflow-hidden w-full">
  {/*- Background Decoration */}
  <div class="absolute top-0 right-0 w-96 h-96 bg-primary/5 rounded-full blur-3xl"></div>

  <div class="w-full max-w-screen-2xl mx-auto grid md:grid-cols-2 gap-12 items-center relative z-10">
    
    <!-- Mission -->
    <div class="animate-on-scroll scroll-left group bg-white rounded-3xl p-8 sm:p-10 border border-border/80 shadow-md">
      <div class="flex items-center gap-4 mb-6">
        <div class="p-4 rounded-2xl bg-royal-blue/10 text-royal-blue">
          <Target class="w-8 h-8" />
        </div>
        <h2 class="text-3xl md:text-4xl font-extrabold">{t.mission.title}</h2>
      </div>
      <p class="text-lg text-muted-foreground leading-relaxed">{t.mission.description}</p>
    </div>

    <!-- Vision -->
    <div class="animate-on-scroll scroll-right group bg-white rounded-3xl p-8 sm:p-10 border border-border/80 shadow-md">
      <div class="flex items-center gap-4 mb-6">
        <div class="p-4 rounded-2xl bg-emerald-accent/10 text-emerald-accent">
          <Eye class="w-8 h-8" />
        </div>
        <h2 class="text-3xl md:text-4xl font-extrabold">{t.vision.title}</h2>
      </div>
      <p class="text-lg text-muted-foreground leading-relaxed">{t.vision.description}</p>
    </div>

  </div>
</section>
