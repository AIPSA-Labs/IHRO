---
//- Official IHRO Field Gazette and Newsletter Subscription component connected to /api/newsletter

import { getStrings } from "../../constants/strings";
import { translations as nlTranslations } from "../../locals/home/newsletter";

type Locale = 'en' | 'hi' | 'fr';
const { local = "en" } = Astro.params;
const s = getStrings(local);
const nl = nlTranslations[local as Locale] || nlTranslations['en'];
---

<section class="py-20 md:py-28 bg-white text-zinc-900 border-b border-gray-100 overflow-hidden w-full" id="newsletter">
  <div class="w-full max-w-screen-2xl mx-auto px-6 sm:px-10 lg:px-16 xl:px-20">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">

      {/*- Left Column: Newsletter Subscription Form */}
      <div class="lg:col-span-6 flex flex-col items-start animate-on-scroll">
        <span class="text-coral text-xs font-bold uppercase tracking-wider block mb-2">
          Official Dispatches
        </span>
        <h2 class="font-['Newsreader'] text-4xl sm:text-5xl font-bold tracking-tight text-zinc-900 leading-tight mb-3">
          {nl.title}
        </h2>
        <p class="font-['Inter'] text-sm sm:text-base text-zinc-600 leading-relaxed font-normal mb-8 max-w-lg">
          {nl.subtitle}
        </p>

        <form id="newsletterForm" class="w-full space-y-4">
          {/*- Email Address Field */}
          <div>
            <label for="newsletterEmail" class="block text-xs font-bold uppercase tracking-wider text-zinc-700 mb-1.5">
              Email Address
            </label>
            <div class="flex flex-col sm:flex-row gap-3">
              <input
                id="newsletterEmail"
                name="email"
                type="email"
                required
                placeholder={nl.placeholder}
                class="flex-1 px-4 py-3.5 rounded-xl border border-gray-200 focus:border-coral focus:ring-1 focus:ring-coral outline-none bg-gray-50 text-zinc-900 text-sm font-['Inter'] transition-colors"
              />
              <button
                id="newsletterSubmitBtn"
                type="submit"
                class="px-8 py-3.5 rounded-xl sm:rounded-full bg-coral hover:bg-coral-hover text-white text-xs font-bold uppercase tracking-wider shadow-md transition-all cursor-pointer shrink-0"
              >
                <span id="newsletterSubmitText">{nl.cta}</span>
              </button>
            </div>
          </div>

          {/*- Status Notification */}
          <p id="newsletterMsg" class="hidden text-xs font-semibold pt-1"></p>

          <p class="text-[11px] text-zinc-600 font-normal pt-1">
            We respect your privacy. No spam, unsubscribe at any time.
          </p>
        </form>
      </div>

      {/*- Right Column: Organic Circular Artwork */}
      <div class="lg:col-span-6 relative flex justify-center items-center animate-on-scroll scroll-scale delay-150">
        {/*- Decorative rings */}
        <div class="absolute w-80 h-80 sm:w-96 sm:h-96 rounded-full border border-coral/30 -top-6 -right-6 pointer-events-none animate-float"></div>

        <div class="relative z-10 w-80 h-80 sm:w-[420px] sm:h-[420px] rounded-full overflow-hidden shadow-2xl border-4 border-white bg-gray-100">
          <img
            src="https://images.pexels.com/photos/7345449/pexels-photo-7345449.jpeg?auto=compress&cs=tinysrgb&w=900"
            alt="Humanitarian Solidarity"
            class="w-full h-full object-cover"
            loading="lazy"
          />
        </div>
      </div>

    </div>
  </div>
</section>

<script define:vars={{
  currentLocale: local,
  defaultCta: nl.cta,
  successText: s.api.newsletterSuccess,
  alreadySubscribedText: s.api.newsletterAlreadySubscribed,
  invalidEmailText: s.api.newsletterEmailInvalid,
  failText: s.api.newsletterSaveFailed
}}>
  //- Newsletter subscription handler wired to /api/newsletter
  const form = document.getElementById('newsletterForm');
  const emailInput = document.getElementById('newsletterEmail');
  const submitBtn = document.getElementById('newsletterSubmitBtn');
  const submitText = document.getElementById('newsletterSubmitText');
  const msg = document.getElementById('newsletterMsg');

  if (form) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      const emailVal = emailInput ? emailInput.value.trim() : '';
      if (!emailVal) {
        return;
      }

      if (submitBtn) {
        submitBtn.disabled = true;
      }
      if (submitText) {
        submitText.textContent = '...';
      }

      try {
        const response = await fetch('/api/newsletter', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email: emailVal, locale: currentLocale }),
        });

        const data = await response.json();

        if (msg) {
          msg.classList.remove('hidden');
          if (response.ok && data.success) {
            msg.textContent = data.message || successText;
            msg.className = 'text-xs font-semibold pt-1 text-emerald-700';
            form.reset();
          } else {
            msg.textContent = data.error || failText;
            msg.className = 'text-xs font-semibold pt-1 text-red-600';
          }
        }
      } catch (err) {
        if (msg) {
          msg.classList.remove('hidden');
          msg.textContent = failText;
          msg.className = 'text-xs font-semibold pt-1 text-red-600';
        }
      } finally {
        if (submitBtn) {
          submitBtn.disabled = false;
        }
        if (submitText) {
          submitText.textContent = defaultCta;
        }
      }
    });
  }
</script>
