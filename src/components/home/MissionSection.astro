---
//- Three-card impact pillar section matching the reference layout with white cards
import { getStrings } from "../../constants/strings";

const { local = "en" } = Astro.params;
const s = getStrings(local);
---

<section id="mission" class="relative pt-20 pb-20 md:pb-28 bg-royal-blue text-white overflow-hidden w-full scroll-mt-20">
  
  <div class="relative w-full max-w-screen-2xl mx-auto px-6 sm:px-10 lg:px-16 xl:px-20">
    
    {/*- Section Header */}
    <div class="text-center max-w-2xl mx-auto mb-16 md:mb-20 animate-on-scroll">
      <h2 class="font-['Hanken_Grotesk'] text-3xl sm:text-4xl md:text-5xl font-bold tracking-tight text-white mb-6 leading-tight">
        <span>{s.pillars.sectionTitleLine1}</span><br />
        <span>{s.pillars.sectionTitleLine2}</span>
      </h2>
      <p class="font-['Inter'] text-sm sm:text-base text-white/90 leading-relaxed font-light max-w-xl mx-auto">
        {s.pillars.sectionSubtitle}
      </p>
    </div>

    {/*- 3-Card Grid */}
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 lg:gap-8 relative z-10">
      {s.pillars.cards.map((card, index) => (
        <div class={`bg-white rounded-3xl p-6 shadow-xl text-justice-navy flex flex-col justify-between animate-on-scroll delay-${index + 1}`}>
          <div>
            {/*- Inset Photo */}
            <div class="rounded-2xl overflow-hidden mb-6 aspect-video bg-slate-100 shadow-xs">
              <img
                src={card.image}
                alt={card.title}
                class="w-full h-full object-cover"
              />
            </div>
            
            {/*- Title & Description */}
            <h3 class="font-['Hanken_Grotesk'] text-xl font-bold text-justice-navy mb-2 tracking-tight">
              {card.title}
            </h3>
            <p class="font-['Inter'] text-xs sm:text-sm text-on-surface-variant leading-relaxed">
              {card.description}
            </p>
          </div>

          {/*- Action Link */}
          <div class="mt-6 pt-4 border-t border-border/60">
            <a
              href={`/${local}/contact?topic=${encodeURIComponent(card.title.toLowerCase())}`}
              class="inline-flex items-center gap-1.5 text-xs font-semibold text-royal-blue hover:text-black transition-colors"
            >
              <span>{s.pillars.ctaLabel} {card.title}</span>
              <span class="material-symbols-outlined text-sm">arrow_forward</span>
            </a>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>
