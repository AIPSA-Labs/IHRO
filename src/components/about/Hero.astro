---
import { translations } from "../../locals/about/hero";

type Locale = 'en' | 'hi' | 'fr';
const { local = 'en' } = Astro.params ?? {};
const t = translations[local as Locale] || translations['en'];
---

<section class="relative bg-canvas text-justice-navy pt-32 pb-20 sm:pt-40 sm:pb-24 px-6 sm:px-10 lg:px-16 xl:px-20 overflow-hidden w-full border-b border-border">
  <div class="w-full max-w-screen-2xl mx-auto text-center relative z-10">
    <div class="inline-flex items-center gap-2.5 px-4 py-1 border border-border bg-white mb-6 shadow-2xs">
      <span class="w-1.5 h-1.5 bg-honor-gold rounded-full"></span>
      <span class="font-['Cinzel'] text-[10px] font-bold tracking-widest text-royal-blue uppercase">
        Institutional Mandate & Mission
      </span>
      <span class="w-1.5 h-1.5 bg-honor-gold rounded-full"></span>
    </div>
    <h1 class="font-['Newsreader'] text-4xl sm:text-5xl md:text-6xl font-medium mb-6 leading-tight text-justice-navy">{t.title}</h1>
    <div class="w-12 h-0.5 bg-honor-gold mx-auto mb-6"></div>
    <p class="font-['Newsreader'] italic text-lg sm:text-xl md:text-2xl text-royal-blue mb-6 leading-relaxed max-w-3xl mx-auto">{t.subtitle}</p>
    <p class="font-['Inter'] text-sm sm:text-base text-on-surface-variant max-w-3xl mx-auto leading-relaxed">{t.description}</p>
  </div>
</section>
