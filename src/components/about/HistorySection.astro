---
//- Historical timeline of IHRO milestones and treaty participation in modern humanitarian styling

import { translations } from "../../locals/about/history";

type Locale = 'en' | 'hi' | 'fr';
const { local = 'en' } = Astro.params ?? {};
const t = translations[local as Locale] || translations['en'];
---

<section class="bg-gray-50 text-zinc-900 py-20 md:py-28 px-6 sm:px-10 lg:px-16 xl:px-20 relative overflow-hidden w-full border-b border-gray-100">
  <div class="w-full max-w-screen-2xl mx-auto relative z-10">
    <div class="text-center mb-16 max-w-2xl mx-auto animate-on-scroll">
      <span class="text-coral text-xs sm:text-sm font-bold tracking-widest uppercase mb-2 block">
        Our Journey
      </span>
      <h2 class="font-['Newsreader'] text-3xl sm:text-4xl md:text-5xl font-bold mb-4 text-zinc-900">
        {t.title}
      </h2>
    </div>

    <div class="relative">
      {/*- Central Timeline Divider Line */}
      <div class="absolute left-4 md:left-1/2 top-0 bottom-0 w-0.5 bg-gray-200"></div>

      <div class="space-y-10 sm:space-y-12">
        {t.timeline.map((event, index) => (
          <div class={`relative flex flex-col md:flex-row ${index % 2 === 0 ? 'md:flex-row-reverse' : ''} items-start md:items-center gap-6 md:gap-12 pl-10 md:pl-0 animate-on-scroll`}>
            {/*- Timeline Pin */}
            <div class="absolute left-4 md:left-1/2 top-8 md:top-auto w-3.5 h-3.5 bg-coral border-2 border-white rounded-full -translate-x-1/2 z-10 shadow-xs"></div>
            
            {/*- Archival Milestone Dossier */}
            <div class={`bg-white border border-gray-100 rounded-2xl p-6 sm:p-8 shadow-sm w-full md:w-[calc(50%-2rem)] ${index % 2 === 0 ? 'md:mr-auto' : 'md:ml-auto'}`}>
              <span class="inline-block px-3 py-1 rounded-full bg-coral/10 text-coral text-xs font-bold uppercase tracking-wider mb-3">
                {event.year}
              </span>
              <h3 class="font-['Newsreader'] text-xl font-bold mb-2 text-zinc-900">{event.title}</h3>
              <p class="font-['Inter'] text-sm text-zinc-600 leading-relaxed font-normal">{event.description}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
