---
//- About Section for landing page with image card, impact badge, and key statistics
import { translations } from "../../locals/home/about";

type Locale = "en" | "hi" | "fr";
const { local = "en" } = Astro.params ?? {};
const t = translations[local as Locale] || translations["en"];
---

<section class="py-20 md:py-28 px-4 md:px-8 bg-white border-b border-gray-100" id="about">
  <div class="max-w-7xl mx-auto">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-10 md:gap-16 items-center">

      {/*- Left column: image with overlay badge */}
      <div class="animate-on-scroll scroll-left">
        <div class="relative rounded-2xl overflow-hidden shadow-lg border border-gray-100">
          <img
            src="https://images.pexels.com/photos/3184418/pexels-photo-3184418.jpeg"
            alt="IHRO Team"
            class="w-full h-64 sm:h-80 md:h-96 object-cover"
          />
        </div>
      </div>

      {/*- Right column: content */}
      <div class="animate-on-scroll scroll-right delay-1">

        {/*- Heading */}
        <h2 class="text-3xl sm:text-4xl md:text-5xl font-bold font-['Hanken_Grotesk'] text-blue-900 mb-6 leading-tight">
          {t.title}
        </h2>

        {/*- Description */}
        <p class="text-gray-600 leading-relaxed mb-8 text-base font-['Inter']">
          {t.description}
        </p>

        {/*- Stat rows */}
        <ul class="space-y-3 mb-8">
          <li class="flex items-center gap-3">
            <span class="material-symbols-outlined text-blue-800 text-xl">check_circle</span>
            <span class="text-gray-800 font-medium font-['Inter']">50+ Countries with Active Outreach</span>
          </li>
          <li class="flex items-center gap-3">
            <span class="material-symbols-outlined text-green-700 text-xl">check_circle</span>
            <span class="text-gray-800 font-medium font-['Inter']">10,000+ Human Rights Beneficiaries</span>
          </li>
          <li class="flex items-center gap-3">
            <span class="material-symbols-outlined text-yellow-600 text-xl">check_circle</span>
            <span class="text-gray-800 font-medium font-['Inter']">Founded with International Headquarters in Germany</span>
          </li>
        </ul>

        {/*- CTA button */}
        <a
          href={`/${local}/about`}
          class="bg-blue-800 text-white px-8 py-3.5 rounded-lg inline-flex items-center gap-2 font-semibold hover:bg-blue-900 transition-colors active:scale-95 text-sm shadow-sm group"
        >
          <span>{t.cta}</span>
          <span class="material-symbols-outlined text-lg group-hover:translate-x-1 transition-transform">
            arrow_forward
          </span>
        </a>

      </div>

    </div>
  </div>
</section>
