---
//- Global footer matching the exact reference video layout with multi-column links, social handles, and copyright

import { getStrings } from "../../constants/strings";
import { CONFIG } from "../../constants/config";

const { local = "en" } = Astro.params;
const s = getStrings(local);
---

<footer class="bg-charcoal text-white pt-16 pb-12 w-full">
  <div class="w-full max-w-screen-2xl mx-auto px-6 sm:px-10 lg:px-16 xl:px-20">
    
    {/*- Main Footer Columns */}
    <div class="grid grid-cols-1 md:grid-cols-12 gap-12 mb-16">
      
      {/*- Brand Summary & Direct Contact */}
      <div class="md:col-span-6 lg:col-span-5">
        <div class="flex flex-col mb-4">
          <span class="font-['Hanken_Grotesk'] text-base md:text-lg font-bold text-white leading-tight">
            {s.brand.name}
          </span>
          <span class="font-['Inter'] text-xs text-white/70 font-normal mt-1">
            {s.brand.fullName}
          </span>
        </div>
        <p class="font-['Inter'] text-xs sm:text-sm text-white/70 leading-relaxed max-w-sm mb-6">
          {s.footer.brandDesc}
        </p>
        <div class="space-y-1.5 text-xs text-white/60 font-['Inter']">
          <p>
            <a href={`mailto:${CONFIG.CONTACT_INFO.EMAIL}`} class="hover:text-white transition-colors underline-offset-2 hover:underline">
              {CONFIG.CONTACT_INFO.EMAIL}
            </a>
          </p>
          <p>
            <a href={`tel:${CONFIG.CONTACT_INFO.PHONE}`} class="hover:text-white transition-colors underline-offset-2 hover:underline">
              {CONFIG.CONTACT_INFO.PHONE_FORMATTED}
            </a>
          </p>
          <p>{CONFIG.CONTACT_INFO.ADDRESS}</p>
        </div>
      </div>

      {/*- Spacer */}
      <div class="hidden lg:block lg:col-span-1"></div>

      {/*- Quick Links */}
      <div class="md:col-span-3 lg:col-span-3">
        <h4 class="font-['Hanken_Grotesk'] text-xs font-semibold uppercase tracking-wider text-white/40 mb-4">
          {s.footer.quickLinksTitle}
        </h4>
        <ul class="space-y-2.5 font-['Inter'] text-xs sm:text-sm">
          <li><a href={`/${local}/`} class="text-white/80 hover:text-white transition-colors">{s.footer.links.home}</a></li>
          <li><a href={`/${local}/about`} class="text-white/80 hover:text-white transition-colors">{s.footer.links.about}</a></li>
          <li><a href={`/${local}/#mission`} class="text-white/80 hover:text-white transition-colors">{s.footer.links.mission}</a></li>
          <li><a href={`/${local}/about#policies`} class="text-white/80 hover:text-white transition-colors">{s.footer.links.programs}</a></li>
          <li><a href={`/${local}/contact`} class="text-white/80 hover:text-white transition-colors">{s.footer.links.contact}</a></li>
        </ul>
      </div>

      {/*- Connect Links (Real external links with new tab attributes) */}
      <div class="md:col-span-3 lg:col-span-3">
        <h4 class="font-['Hanken_Grotesk'] text-xs font-semibold uppercase tracking-wider text-white/40 mb-4">
          {s.footer.connectTitle}
        </h4>
        <ul class="space-y-2.5 font-['Inter'] text-xs sm:text-sm">
          <li>
            <a
              href={CONFIG.SOCIAL_URLS.LINKEDIN}
              target="_blank"
              rel="noopener noreferrer"
              class="text-white/80 hover:text-white transition-colors inline-flex items-center gap-1.5"
            >
              <span>{s.footer.links.linkedin}</span>
              <span class="material-symbols-outlined text-xs">arrow_outward</span>
            </a>
          </li>
          <li>
            <a
              href={CONFIG.SOCIAL_URLS.INSTAGRAM}
              target="_blank"
              rel="noopener noreferrer"
              class="text-white/80 hover:text-white transition-colors inline-flex items-center gap-1.5"
            >
              <span>{s.footer.links.instagram}</span>
              <span class="material-symbols-outlined text-xs">arrow_outward</span>
            </a>
          </li>
          <li>
            <a
              href={CONFIG.SOCIAL_URLS.YOUTUBE}
              target="_blank"
              rel="noopener noreferrer"
              class="text-white/80 hover:text-white transition-colors inline-flex items-center gap-1.5"
            >
              <span>{s.footer.links.youtube}</span>
              <span class="material-symbols-outlined text-xs">arrow_outward</span>
            </a>
          </li>
          <li>
            <a
              href={CONFIG.SOCIAL_URLS.TWITTER}
              target="_blank"
              rel="noopener noreferrer"
              class="text-white/80 hover:text-white transition-colors inline-flex items-center gap-1.5"
            >
              <span>{s.footer.links.twitter}</span>
              <span class="material-symbols-outlined text-xs">arrow_outward</span>
            </a>
          </li>
        </ul>
      </div>

    </div>

    {/*- Bottom Bar */}
    <div class="pt-8 border-t border-white/10 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs font-['Inter'] text-white/50">
      <p>{s.footer.copyright}</p>
      <div class="flex items-center gap-4">
        <a href={`/${local}/privacy`} class="hover:text-white transition-colors">{s.footer.privacyPolicy}</a>
        <span>•</span>
        <a href={`/${local}/terms`} class="hover:text-white transition-colors">{s.footer.termsCondition}</a>
      </div>
    </div>

  </div>
</footer>
