---
//- Bottom coral highlight banner "Your Donation Empowers Those in Need" with white pill button and children HOPE photo

import { getStrings } from "../../constants/strings";

const { local = "en" } = Astro.params;
const s = getStrings(local);
---

<section class="py-16 md:py-24 bg-white w-full">
  <div class="w-full max-w-screen-2xl mx-auto px-6 sm:px-10 lg:px-16 xl:px-20">
    
    <div class="relative bg-coral text-white rounded-3xl overflow-hidden shadow-2xl p-8 sm:p-12 md:p-16 animate-on-scroll scroll-scale">
      
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center relative z-10">
        
        {/*- Left Content */}
        <div class="lg:col-span-8 flex flex-col items-start">
          <h2 class="font-['Newsreader'] text-3xl sm:text-4xl md:text-5xl font-bold tracking-tight text-white leading-tight mb-4">
            {s.donationBanner.title}
          </h2>
          <p class="font-['Inter'] text-sm sm:text-base text-white/90 leading-relaxed font-normal max-w-xl mb-8">
            {s.donationBanner.subtitle}
          </p>
          <a
            href={`/${local}/contact?type=donate`}
            class="inline-flex items-center justify-center px-8 py-3.5 rounded-full bg-white hover:bg-zinc-100 text-coral text-xs font-bold uppercase tracking-wider shadow-lg transition-colors cursor-pointer"
          >
            {s.donationBanner.cta}
          </a>
        </div>

        {/*- Right Photo: Children Holding "HOPE" Sign */}
        <div class="lg:col-span-4 flex justify-center lg:justify-end">
          <div class="w-64 sm:w-80 aspect-[4/3] rounded-2xl overflow-hidden border-4 border-white/30 shadow-xl bg-white/10">
            <img
              src="https://images.pexels.com/photos/8926543/pexels-photo-8926543.jpeg?auto=compress&cs=tinysrgb&w=800"
              alt="Hope for Children"
              class="w-full h-full object-cover"
              loading="lazy"
            />
          </div>
        </div>

      </div>

      {/*- Decorative background glow */}
      <div class="absolute -bottom-24 -left-24 w-80 h-80 rounded-full bg-white/10 blur-3xl pointer-events-none"></div>

    </div>

  </div>
</section>
