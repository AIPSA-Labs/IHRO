---
//- Policies & Principles section with white cards and multicolor left accents
import { translations } from "../../locals/about/policies";
import { Shield, Scale, BookOpen, Users, Globe } from "@lucide/astro";

type Locale = "en" | "hi" | "fr";
const { local = "en" } = Astro.params ?? {};
const t = translations[local as Locale] || translations["en"];

const POLICY_CONFIGS = [
  { icon: Shield,   iconBg: "bg-blue-50 text-blue-800",   borderClass: "border-l-4 border-l-blue-800" },
  { icon: Scale,    iconBg: "bg-red-50 text-red-600",     borderClass: "border-l-4 border-l-red-600" },
  { icon: Globe,    iconBg: "bg-green-50 text-green-700", borderClass: "border-l-4 border-l-green-700" },
  { icon: BookOpen, iconBg: "bg-yellow-50 text-yellow-600", borderClass: "border-l-4 border-l-yellow-500" },
  { icon: Users,    iconBg: "bg-purple-50 text-purple-700", borderClass: "border-l-4 border-l-purple-700" },
];
---

<section class="bg-gray-50 py-24 px-4 md:px-8 border-b border-gray-100 relative overflow-hidden">
  <div class="max-w-7xl mx-auto">

    {/*- Section header */}
    <div class="text-center mb-16">
      <h2 class="animate-on-scroll font-['Hanken_Grotesk'] text-4xl font-bold text-blue-900 mb-4">
        {t.title}
      </h2>
      <p class="animate-on-scroll delay-1 font-['Inter'] text-gray-500 text-base max-w-2xl mx-auto">
        {t.subtitle}
      </p>
    </div>

    {/*- Policy Cards Grid */}
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {t.policies.map((policy, index) => {
        const config = POLICY_CONFIGS[index % POLICY_CONFIGS.length];
        const IconComponent = config.icon;

        return (
          <div class={`bg-white rounded-xl md:rounded-2xl p-6 md:p-8 border border-gray-200 shadow-sm hover:shadow-md transition-shadow flex flex-col gap-4 ${config.borderClass}`}>
            <div class={`w-12 h-12 rounded-xl flex items-center justify-center ${config.iconBg}`}>
              <IconComponent class="w-6 h-6" />
            </div>
            <h3 class="font-['Hanken_Grotesk'] text-xl font-bold text-gray-900">
              {policy.title}
            </h3>
            <p class="font-['Inter'] text-gray-600 leading-relaxed text-sm">
              {policy.description}
            </p>
          </div>
        );
      })}
    </div>

  </div>
</section>
