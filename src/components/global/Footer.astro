---
//- Footer component with dark slate theme, multicolor accents, newsletter strip, and bottom bar
import { footerTranslations } from "../../locals/global/footer";
import { Facebook, Twitter, Linkedin, Instagram, Mail, Phone, MapPin } from "@lucide/astro";

const currentYear = new Date().getFullYear();

type Locale = "en" | "hi" | "fr";
const { local = "en" } = Astro.params ?? {};
const t = footerTranslations[local as Locale] || footerTranslations["en"];
---

<footer class="bg-gray-950 text-white">

  {/*- Colored accent bar at the very top of the footer */}
  <div class="colored-bar">
    <span></span><span></span><span></span><span></span><span></span>
  </div>

  <div class="max-w-screen-2xl mx-auto px-4 md:px-8 lg:px-10 pt-16 pb-10">

    {/*- Top 5-column grid */}
    <div class="grid grid-cols-1 md:grid-cols-12 gap-10 mb-12">

      {/*- Col 1: Brand (wider) */}
      <div class="md:col-span-4">
        <div class="flex items-center gap-3 mb-5">
          <div class="w-10 h-10 bg-white rounded-full flex items-center justify-center p-1">
            <img src="/favicon.svg" alt="IHRO Logo" class="w-full h-full object-contain" />
          </div>
          <span class="font-['Hanken_Grotesk'] text-2xl font-bold tracking-tight">IHRO</span>
        </div>
        <p class="text-gray-400 font-['Inter'] text-sm leading-relaxed mb-6">
          {t.brandDesc}
        </p>
        {/*- Social media links */}
        <div class="flex gap-3">
          <a
            href="https://facebook.com"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Facebook"
            class="w-9 h-9 rounded-full bg-white/10 flex items-center justify-center hover:bg-blue-600 hover:text-white text-gray-300 transition-colors"
          >
            <Facebook class="w-4 h-4" />
          </a>
          <a
            href="https://twitter.com"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Twitter"
            class="w-9 h-9 rounded-full bg-white/10 flex items-center justify-center hover:bg-sky-500 hover:text-white text-gray-300 transition-colors"
          >
            <Twitter class="w-4 h-4" />
          </a>
          <a
            href="https://linkedin.com"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="LinkedIn"
            class="w-9 h-9 rounded-full bg-white/10 flex items-center justify-center hover:bg-blue-700 hover:text-white text-gray-300 transition-colors"
          >
            <Linkedin class="w-4 h-4" />
          </a>
          <a
            href="https://instagram.com"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Instagram"
            class="w-9 h-9 rounded-full bg-white/10 flex items-center justify-center hover:bg-pink-600 hover:text-white text-gray-300 transition-colors"
          >
            <Instagram class="w-4 h-4" />
          </a>
        </div>
      </div>

      {/*- Col 2: Organization */}
      <div class="md:col-span-2">
        <h4 class="font-['Inter'] text-xs font-semibold text-gray-400 mb-5 uppercase tracking-widest">
          {t.linksTitle}
        </h4>
        <ul class="space-y-3">
          <li>
            <a class="text-gray-400 hover:text-white transition-colors font-['Inter'] text-sm" href={`/${local}/`}>
              {t.links.home}
            </a>
          </li>
          <li>
            <a class="text-gray-400 hover:text-white transition-colors font-['Inter'] text-sm" href={`/${local}/about`}>
              {t.links.about}
            </a>
          </li>
          <li>
            <a class="text-gray-400 hover:text-white transition-colors font-['Inter'] text-sm" href={`/${local}/faq`}>
              FAQ
            </a>
          </li>
          <li>
            <a class="text-gray-400 hover:text-white transition-colors font-['Inter'] text-sm" href={`/${local}/contact`}>
              {t.links.contact || "Contact"}
            </a>
          </li>
        </ul>
      </div>

      {/*- Col 3: Support */}
      <div class="md:col-span-2">
        <h4 class="font-['Inter'] text-xs font-semibold text-gray-400 mb-5 uppercase tracking-widest">
          {t.supportTitle}
        </h4>
        <ul class="space-y-3">
          <li>
            <a class="text-gray-400 hover:text-white transition-colors font-['Inter'] text-sm" href="/donate">
              {t.supportLinks.donate}
            </a>
          </li>
          <li>
            <a class="text-gray-400 hover:text-white transition-colors font-['Inter'] text-sm" href="/volunteer">
              {t.supportLinks.volunteer}
            </a>
          </li>
          <li>
            <a class="text-gray-400 hover:text-white transition-colors font-['Inter'] text-sm" href={`/${local}/contact`}>
              {t.supportLinks.newsletter}
            </a>
          </li>
        </ul>
      </div>

      {/*- Col 4: Legal */}
      <div class="md:col-span-2">
        <h4 class="font-['Inter'] text-xs font-semibold text-gray-400 mb-5 uppercase tracking-widest">
          {t.legalTitle}
        </h4>
        <ul class="space-y-3">
          <li>
            <a class="text-gray-400 hover:text-white transition-colors font-['Inter'] text-sm" href={`/${local}/privacy`}>
              {t.links.privacy}
            </a>
          </li>
          <li>
            <a class="text-gray-400 hover:text-white transition-colors font-['Inter'] text-sm" href={`/${local}/terms`}>
              {t.links.terms}
            </a>
          </li>
          <li>
            <a class="text-gray-400 hover:text-white transition-colors font-['Inter'] text-sm" href="#">
              {t.links.ethicsCharter}
            </a>
          </li>
        </ul>
      </div>

      {/*- Col 5: Contact Us */}
      <div class="md:col-span-2">
        <h4 class="font-['Inter'] text-xs font-semibold text-gray-400 mb-5 uppercase tracking-widest">
          {t.contactTitle}
        </h4>
        <div class="space-y-4 text-gray-400 text-sm font-['Inter']">
          <p class="flex items-start gap-2.5 group">
            <Mail class="w-4 h-4 text-gray-400 group-hover:text-white shrink-0 mt-0.5 transition-colors" />
            <a href="mailto:info@ihro.world" class="hover:text-white transition-colors">info@ihro.world</a>
          </p>
          <p class="flex items-start gap-2.5 group">
            <Phone class="w-4 h-4 text-gray-400 group-hover:text-white shrink-0 mt-0.5 transition-colors" />
            <a href="tel:+4917645983857" class="hover:text-white transition-colors">+4917645983857</a>
          </p>
          <p class="flex items-start gap-2.5">
            <MapPin class="w-4 h-4 text-gray-400 shrink-0 mt-0.5" />
            <span>Mallinckrodstraße 167, Dortmund, Germany</span>
          </p>
        </div>
      </div>

    </div>

    {/*- Newsletter strip */}
    <div class="border-t border-gray-800 pt-10 pb-8">
      <div class="flex flex-col md:flex-row items-center justify-between gap-8">
        <div class="text-left max-w-sm">
          <h3 class="font-['Hanken_Grotesk'] text-2xl font-semibold text-white mb-2">
            {t.newsletter.title}
          </h3>
          <p class="text-gray-400 font-['Inter'] text-sm">{t.newsletter.subtitle}</p>
        </div>
        <form id="footerNewsletterForm" class="w-full md:w-auto flex flex-col sm:flex-row gap-3">
          <input
            id="footerNewsletterEmail"
            type="email"
            placeholder={t.newsletter.placeholder}
            required
            class="flex-grow sm:w-72 p-3 rounded-lg border border-gray-700 bg-gray-900 text-white placeholder-gray-500 font-['Inter'] text-sm focus:outline-none focus:ring-2 focus:ring-blue-800"
          />
          <button
            id="footerNewsletterBtn"
            type="submit"
            class="bg-blue-800 text-white px-6 py-3 rounded-lg font-['Inter'] text-sm font-semibold hover:bg-blue-900 transition-colors cursor-pointer whitespace-nowrap active:scale-95"
          >
            <span id="footerNewsletterBtnText">{t.newsletter.cta}</span>
          </button>
        </form>
      </div>
    </div>

    {/*- Bottom bar */}
    <div class="pt-6 border-t border-gray-800 flex flex-col md:flex-row justify-between items-center gap-4">
      <p class="text-gray-400 font-['Inter'] text-xs">
        &copy; {currentYear} International Human Rights Organization. {t.copyright}
      </p>
      <div class="flex gap-6">
        <a class="text-gray-400 hover:text-white text-xs uppercase tracking-widest transition-colors" href="#">
          {t.termsOfService}
        </a>
        <a class="text-gray-400 hover:text-white text-xs uppercase tracking-widest transition-colors" href="#">
          {t.cookiePolicy}
        </a>
      </div>
    </div>

  </div>
</footer>

<script>
  //- Handle newsletter subscription via real AIPSA Database API
  const newsletterForm = document.getElementById("footerNewsletterForm") as HTMLFormElement | null;
  const newsletterEmail = document.getElementById("footerNewsletterEmail") as HTMLInputElement | null;
  const newsletterBtn = document.getElementById("footerNewsletterBtn") as HTMLButtonElement | null;
  const newsletterBtnText = document.getElementById("footerNewsletterBtnText");

  if (newsletterForm && newsletterBtn) {
    newsletterForm.addEventListener("submit", async (e) => {
      e.preventDefault();

      const email = newsletterEmail ? newsletterEmail.value.trim() : "";
      if (!email) {
        return;
      }

      const originalText = newsletterBtnText ? newsletterBtnText.textContent : "Subscribe";
      newsletterBtn.disabled = true;
      newsletterBtn.classList.add("opacity-75", "cursor-not-allowed");
      if (newsletterBtnText) {
        newsletterBtnText.textContent = "...";
      }

      try {
        const response = await fetch("/api/newsletter", {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
          },
          body: JSON.stringify({ email: email }),
        });

        const data = await response.json().catch(() => ({}));

        if (response.ok && data.success) {
          newsletterForm.reset();
          // @ts-ignore
          if (typeof window.showToast === "function") {
            // @ts-ignore
            window.showToast({
              type: "success",
              title: "Subscribed",
              message: data.message || "Thank you for subscribing to IHRO updates.",
            });
          }
        } else {
          // @ts-ignore
          if (typeof window.showToast === "function") {
            // @ts-ignore
            window.showToast({
              type: "error",
              title: "Subscription Notice",
              message: data.error || "We could not process your subscription right now.",
            });
          }
        }
      } catch (err) {
        // @ts-ignore
        if (typeof window.showToast === "function") {
          // @ts-ignore
          window.showToast({
            type: "error",
            title: "Network Issue",
            message: "We're having trouble connecting. Please check your internet connection.",
          });
        }
      } finally {
        newsletterBtn.disabled = false;
        newsletterBtn.classList.remove("opacity-75", "cursor-not-allowed");
        if (newsletterBtnText) {
          newsletterBtnText.textContent = originalText;
        }
      }
    });
  }
</script>
