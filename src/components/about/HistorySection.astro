---
//- History & Timeline section with white background and multicolor milestone tags
import { translations } from "../../locals/about/history";

type Locale = "en" | "hi" | "fr";
const { local = "en" } = Astro.params ?? {};
const t = translations[local as Locale] || translations["en"];

//- Distinct multicolor badge styles for each timeline milestone
const TIMELINE_COLORS = [
  { badge: "bg-blue-100 text-blue-800 border-blue-200", dot: "bg-blue-800" },
  { badge: "bg-red-100 text-red-800 border-red-200", dot: "bg-red-600" },
  { badge: "bg-green-100 text-green-800 border-green-200", dot: "bg-green-700" },
  { badge: "bg-yellow-100 text-yellow-800 border-yellow-200", dot: "bg-yellow-500" },
  { badge: "bg-purple-100 text-purple-800 border-purple-200", dot: "bg-purple-700" },
];
---

<section class="bg-white py-24 px-4 md:px-8 border-b border-gray-100 relative overflow-hidden">
  <div class="max-w-7xl mx-auto">

    {/*- Section header */}
    <div class="text-center mb-16">
      <h2 class="animate-on-scroll font-['Hanken_Grotesk'] text-4xl font-bold text-blue-900 mb-4">
        {t.title}
      </h2>
      <div class="w-16 h-1 bg-blue-800 mx-auto rounded-full"></div>
    </div>

    {/*- Timeline container */}
    <div class="relative max-w-5xl mx-auto">

      {/*- Center timeline vertical line (desktop) */}
      <div class="hidden md:block absolute left-1/2 top-0 bottom-0 w-0.5 bg-gray-200 -translate-x-1/2"></div>
      {/*- Left timeline vertical line (mobile) */}
      <div class="block md:hidden absolute left-4 top-0 bottom-0 w-0.5 bg-gray-200"></div>

      <div class="space-y-12">
        {t.timeline.map((event, index) => {
          const color = TIMELINE_COLORS[index % TIMELINE_COLORS.length];
          const isEven = index % 2 === 0;

          return (
            <div class={`relative flex flex-col md:flex-row items-center gap-6 md:gap-12 ${isEven ? "" : "md:flex-row-reverse"}`}>

              {/*- Timeline Milestone Dot */}
              <div class={`absolute left-4 md:left-1/2 w-4 h-4 rounded-full ${color.dot} -translate-x-1/2 z-10 ring-4 ring-white shadow-sm`}></div>

              {/*- Milestone Card */}
              <div class={`w-full md:w-1/2 pl-10 sm:pl-12 md:pl-0 ${isEven ? "md:pr-12 md:text-right" : "md:pl-12 md:text-left"}`}>
                <div class="bg-white border border-gray-200 rounded-xl md:rounded-2xl p-4 sm:p-6 md:p-8 shadow-sm hover:shadow-md transition-shadow">
                  <span class={`inline-block text-xs font-bold uppercase tracking-wider px-2.5 py-1 rounded-md border mb-3 ${color.badge}`}>
                    {event.year}
                  </span>
                  <h3 class="font-['Hanken_Grotesk'] text-xl font-bold text-gray-900 mb-2">
                    {event.title}
                  </h3>
                  <p class="font-['Inter'] text-gray-600 leading-relaxed text-sm">
                    {event.description}
                  </p>
                </div>
              </div>

              {/*- Empty opposite column for alignment on desktop */}
              <div class="hidden md:block md:w-1/2"></div>

            </div>
          );
        })}
      </div>

    </div>

  </div>
</section>
