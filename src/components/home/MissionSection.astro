---
//- Mission / Core Values section with white background, multicolor icon cards, and localized links
import { translations } from "../../locals/home/mission";

type Locale = "en" | "hi" | "fr";
const { local = "en" } = Astro.params ?? {};
const t = translations[local as Locale] || translations["en"];

//- Per-card color config: icon container colors and accent styling
const CARD_COLORS = [
  { iconBg: "bg-blue-800",  linkColor: "text-blue-800",  borderHover: "hover:border-blue-700" },
  { iconBg: "bg-red-600",   linkColor: "text-red-600",   borderHover: "hover:border-red-600" },
  { iconBg: "bg-green-700", linkColor: "text-green-700", borderHover: "hover:border-green-700" },
];
---

<section id="mission" class="bg-white py-20 md:py-28 px-4 md:px-8 border-b border-gray-100">
  <div class="max-w-7xl mx-auto">

    {/*- Section header */}
    <div class="text-center mb-12 md:mb-16">
      <h2 class="font-['Hanken_Grotesk'] text-3xl sm:text-4xl md:text-5xl font-bold text-blue-900 leading-tight mb-4">
        {t.title}
      </h2>
      <div class="w-16 h-1 bg-blue-800 mx-auto rounded-full"></div>
    </div>

    {/*- Mission cards grid */}
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 md:gap-8">
      {t.missionPoints.map((point, index) => {
        const colors = CARD_COLORS[index % CARD_COLORS.length];
        return (
          <div class={`bg-white border border-gray-200 shadow-sm hover:shadow-lg rounded-2xl p-6 md:p-8 flex flex-col gap-5 md:gap-6 transition-all duration-200 ${colors.borderHover}`}>

            {/*- Colored icon container */}
            <div class={`w-14 h-14 ${colors.iconBg} rounded-xl flex items-center justify-center text-white shadow-sm`}>
              <span class="material-symbols-outlined text-3xl">{point.icon}</span>
            </div>

            {/*- Card title */}
            <h3 class="text-2xl font-bold text-gray-900 font-['Hanken_Grotesk']">
              {point.title}
            </h3>

            {/*- Card body */}
            <p class="text-gray-600 leading-relaxed font-['Inter'] text-sm flex-1">
              {point.text}
            </p>

            {/*- Learn more link */}
            <a
              href={`/${local}/about`}
              class={`text-sm font-semibold ${colors.linkColor} hover:underline mt-auto inline-flex items-center gap-1 font-['Inter']`}
            >
              <span>Learn more</span>
              <span class="material-symbols-outlined text-base">arrow_forward</span>
            </a>

          </div>
        );
      })}
    </div>

  </div>
</section>
