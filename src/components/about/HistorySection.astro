---
//- Historical timeline of IHRO milestones and treaty participation
import { translations } from "../../locals/about/history";

type Locale = 'en' | 'hi' | 'fr';
const { local = 'en' } = Astro.params ?? {};
const t = translations[local as Locale] || translations['en'];
---

<section class="bg-canvas text-justice-navy py-24 px-6 sm:px-10 lg:px-16 xl:px-20 relative overflow-hidden w-full border-b border-border">
  <div class="w-full max-w-screen-2xl mx-auto relative z-10">
    <div class="text-center mb-16">
      <h2 class="font-['Newsreader'] text-3xl sm:text-4xl md:text-5xl font-medium mb-4 text-justice-navy">{t.title}</h2>
    </div>

    <div class="relative">
      {/*- Central Timeline Divider Line */}
      <div class="absolute left-4 md:left-1/2 top-0 bottom-0 w-px bg-border"></div>

      <div class="space-y-12">
        {t.timeline.map((event, index) => (
          <div class={`relative flex flex-col md:flex-row ${index % 2 === 0 ? 'md:flex-row-reverse' : ''} items-start md:items-center gap-6 md:gap-12 pl-10 md:pl-0`}>
            {/*- Timeline Pin */}
            <div class="absolute left-4 md:left-1/2 top-8 md:top-auto w-3 h-3 bg-royal-blue border-2 border-white rounded-full -translate-x-1/2 z-10 shadow-xs"></div>
            
            {/*- Archival Milestone Dossier */}
            <div class={`bg-white border border-border p-6 sm:p-8 shadow-2xs w-full md:w-[calc(50%-2rem)] ${index % 2 === 0 ? 'md:mr-auto' : 'md:ml-auto'}`}>
              <span class="inline-block px-3 py-1 rounded-xs border border-border bg-canvas-muted text-royal-blue text-xs font-['Cinzel'] font-bold uppercase tracking-wider mb-3">
                {event.year}
              </span>
              <h3 class="font-['Newsreader'] text-xl font-semibold mb-2 text-justice-navy">{event.title}</h3>
              <p class="font-['Inter'] text-sm text-on-surface-variant leading-relaxed">{event.description}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
