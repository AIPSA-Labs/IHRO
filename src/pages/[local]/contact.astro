---
//- Dedicated Contact page with clean white background, responsive form, and regional offices
import Layout from "../../layouts/Layout.astro";
import { translations } from "../../locals/contact/page";
import { supportedLocales } from "../../locals/languages";
import { MapPin, Phone, Mail, Clock } from "@lucide/astro";

type Locale = "en" | "hi" | "fr";
const { local = "en" } = Astro.params ?? {};
const codes = supportedLocales.map((l) => l.code);

if (!codes.includes(local)) {
  return Astro.redirect("/404");
}

const t = translations[local as Locale] || translations["en"];
---

<Layout>
  {/*- Hero section */}
  <section class="bg-blue-900 text-white pt-24 pb-16 px-4 md:px-8 relative overflow-hidden">
    <div class="max-w-4xl mx-auto text-center relative z-10">

      {/*- Breadcrumb */}
      <nav class="flex justify-center items-center gap-2 text-xs uppercase tracking-wider text-blue-200 mb-6 font-medium">
        <a href={`/${local}/`} class="hover:text-white transition-colors">Home</a>
        <span class="text-blue-400">/</span>
        <span class="text-white">Contact</span>
      </nav>

      {/*- Page Title */}
      <h1 class="font-['Hanken_Grotesk'] text-4xl md:text-5xl font-bold mb-4 tracking-tight">
        {t.title}
      </h1>

      {/*- Subtitle */}
      <p class="font-['Inter'] text-lg text-blue-100 max-w-2xl mx-auto leading-relaxed">
        {t.subtitle}
      </p>

    </div>

    {/*- Multicolor bar divider at hero bottom */}
    <div class="colored-bar absolute bottom-0 left-0 right-0">
      <span></span><span></span><span></span><span></span><span></span>
    </div>
  </section>

  {/*- Main Content Section */}
  <section class="bg-white py-16 px-4 md:px-8">
    <div class="max-w-7xl mx-auto">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">

        {/*- Left Column: Contact Form */}
        <div class="lg:col-span-7 bg-white border border-gray-200 rounded-2xl p-5 sm:p-8 md:p-10 shadow-sm">
          <div class="mb-8">
            <h2 class="font-['Hanken_Grotesk'] text-2xl md:text-3xl font-bold text-blue-900 mb-2">
              {t.form.heading}
            </h2>
            <p class="text-gray-500 font-['Inter'] text-sm">
              {t.form.subheading}
            </p>
          </div>

          <form class="space-y-6" id="contactInquiryForm">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">

              {/*- Name Field */}
              <div class="flex flex-col gap-2">
                <label for="contact-name" class="font-['Inter'] text-sm font-semibold text-gray-700">
                  {t.form.name} <span class="text-red-500">*</span>
                </label>
                <input
                  id="contact-name"
                  type="text"
                  required
                  placeholder={t.form.namePlaceholder}
                  class="w-full px-4 py-3 rounded-lg border border-gray-300 text-gray-900 font-['Inter'] text-sm placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-blue-700 focus:border-blue-700 transition-all"
                />
              </div>

              {/*- Email Field */}
              <div class="flex flex-col gap-2">
                <label for="contact-email" class="font-['Inter'] text-sm font-semibold text-gray-700">
                  {t.form.email} <span class="text-red-500">*</span>
                </label>
                <input
                  id="contact-email"
                  type="email"
                  required
                  placeholder={t.form.emailPlaceholder}
                  class="w-full px-4 py-3 rounded-lg border border-gray-300 text-gray-900 font-['Inter'] text-sm placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-blue-700 focus:border-blue-700 transition-all"
                />
              </div>

            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">

              {/*- Inquiry Category Dropdown */}
              <div class="flex flex-col gap-2">
                <label for="contact-category" class="font-['Inter'] text-sm font-semibold text-gray-700">
                  {t.form.category}
                </label>
                <select
                  id="contact-category"
                  class="w-full px-4 py-3 rounded-lg border border-gray-300 text-gray-900 font-['Inter'] text-sm focus:outline-none focus:ring-2 focus:ring-blue-700 focus:border-blue-700 transition-all bg-white"
                >
                  {t.form.categories.map((cat) => (
                    <option value={cat}>{cat}</option>
                  ))}
                </select>
              </div>

              {/*- Subject Field */}
              <div class="flex flex-col gap-2">
                <label for="contact-subject" class="font-['Inter'] text-sm font-semibold text-gray-700">
                  {t.form.subject}
                </label>
                <input
                  id="contact-subject"
                  type="text"
                  placeholder={t.form.subjectPlaceholder}
                  class="w-full px-4 py-3 rounded-lg border border-gray-300 text-gray-900 font-['Inter'] text-sm placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-blue-700 focus:border-blue-700 transition-all"
                />
              </div>

            </div>

            {/*- Message Field */}
            <div class="flex flex-col gap-2">
              <label for="contact-message" class="font-['Inter'] text-sm font-semibold text-gray-700">
                {t.form.message} <span class="text-red-500">*</span>
              </label>
              <textarea
                id="contact-message"
                required
                rows="5"
                placeholder={t.form.messagePlaceholder}
                class="w-full px-4 py-3 rounded-lg border border-gray-300 text-gray-900 font-['Inter'] text-sm placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-blue-700 focus:border-blue-700 transition-all resize-y"
              ></textarea>
            </div>

            {/*- Submit Button */}
            <button
              id="contactSubmitBtn"
              type="submit"
              class="w-full md:w-auto px-8 py-3.5 bg-blue-800 text-white font-semibold rounded-lg hover:bg-blue-900 transition-colors cursor-pointer text-sm shadow-sm flex items-center justify-center gap-2 active:scale-95"
            >
              <span id="contactSubmitBtnText">{t.form.submit}</span>
              <span class="material-symbols-outlined text-lg">send</span>
            </button>
          </form>
        </div>

        {/*- Right Column: Information & Regional Hubs */}
        <div class="lg:col-span-5 space-y-6">

          {/*- Main Headquarters Card */}
          <div class="bg-blue-900 text-white rounded-2xl p-6 md:p-8 shadow-sm relative overflow-hidden">
            <h3 class="font-['Hanken_Grotesk'] text-2xl font-bold mb-3">
              {t.contact.title}
            </h3>
            <p class="font-['Inter'] text-blue-100 text-sm leading-relaxed mb-6">
              {t.contact.description}
            </p>

            <div class="space-y-4 font-['Inter'] text-sm text-blue-100 border-t border-blue-800 pt-6">
              <div class="flex items-start gap-3">
                <MapPin class="w-5 h-5 text-blue-200 shrink-0 mt-0.5" />
                <div>
                  <p class="font-semibold text-white">{t.contact.addressLabel}</p>
                  <p>{t.contact.address}</p>
                </div>
              </div>

              <div class="flex items-start gap-3">
                <Phone class="w-5 h-5 text-blue-200 shrink-0 mt-0.5" />
                <div>
                  <p class="font-semibold text-white">{t.contact.phoneLabel}</p>
                  <a href={`tel:${t.contact.phone}`} class="hover:text-white transition-colors">{t.contact.phone}</a>
                </div>
              </div>

              <div class="flex items-start gap-3">
                <Mail class="w-5 h-5 text-blue-200 shrink-0 mt-0.5" />
                <div>
                  <p class="font-semibold text-white">{t.contact.emailLabel}</p>
                  <a href={`mailto:${t.contact.email}`} class="hover:text-white transition-colors">{t.contact.email}</a>
                </div>
              </div>

              <div class="flex items-start gap-3">
                <Clock class="w-5 h-5 text-blue-200 shrink-0 mt-0.5" />
                <div>
                  <p class="font-semibold text-white">{t.contact.hoursLabel}</p>
                  <p>{t.contact.hours}</p>
                </div>
              </div>
            </div>
          </div>

          {/*- Urgent Notice Callout */}
          <div class="bg-red-50 border border-red-200 rounded-2xl p-6 flex items-start gap-4">
            <span class="material-symbols-outlined text-red-600 text-2xl flex-shrink-0">priority_high</span>
            <div>
              <h4 class="font-['Hanken_Grotesk'] text-base font-bold text-red-900 mb-1">
                Urgent Assistance Notice
              </h4>
              <p class="font-['Inter'] text-red-800 text-xs leading-relaxed">
                {t.contact.emergencyNotice}
              </p>
            </div>
          </div>

          {/*- Regional Representations */}
          <div class="bg-gray-50 border border-gray-200 rounded-2xl p-6">
            <h4 class="font-['Hanken_Grotesk'] text-lg font-bold text-gray-900 mb-4">
              Regional Representations
            </h4>
            <div class="space-y-4">
              {t.regionalOffices.map((office) => (
                <div class="flex justify-between items-center py-2 border-b border-gray-200 last:border-b-0">
                  <div>
                    <p class="font-['Inter'] font-semibold text-sm text-gray-900">{office.city}</p>
                    <p class="font-['Inter'] text-xs text-gray-500">{office.role}</p>
                  </div>
                  <span class="text-xs font-medium text-blue-800">
                    {office.phone || office.email}
                  </span>
                </div>
              ))}
            </div>
          </div>

          {/*- FAQ Shortcut Card */}
          <div class="bg-white border border-gray-200 rounded-2xl p-6 flex items-center justify-between">
            <div>
              <p class="font-['Hanken_Grotesk'] font-bold text-gray-900 text-base">Have a quick question?</p>
              <p class="font-['Inter'] text-xs text-gray-500">Check our frequently asked questions</p>
            </div>
            <a
              href={`/${local}/faq`}
              class="px-4 py-2 border border-blue-800 text-blue-800 hover:bg-blue-800 hover:text-white rounded-lg text-xs font-semibold transition-colors font-['Inter']"
            >
              View FAQ
            </a>
          </div>

        </div>

      </div>
    </div>
  </section>

  <script>
    //- Handle dynamic contact form submission via real AIPSA Database API
    const form = document.getElementById("contactInquiryForm") as HTMLFormElement | null;
    const submitBtn = document.getElementById("contactSubmitBtn") as HTMLButtonElement | null;
    const submitBtnText = document.getElementById("contactSubmitBtnText");

    if (form && submitBtn) {
      form.addEventListener("submit", async (e) => {
        e.preventDefault();

        const nameInput = document.getElementById("contact-name") as HTMLInputElement | null;
        const emailInput = document.getElementById("contact-email") as HTMLInputElement | null;
        const categorySelect = document.getElementById("contact-category") as HTMLSelectElement | null;
        const subjectInput = document.getElementById("contact-subject") as HTMLInputElement | null;
        const messageInput = document.getElementById("contact-message") as HTMLTextAreaElement | null;

        const name = nameInput ? nameInput.value.trim() : "";
        const email = emailInput ? emailInput.value.trim() : "";
        const category = categorySelect ? categorySelect.value.trim() : "General Inquiry";
        const subject = subjectInput ? subjectInput.value.trim() : "";
        const message = messageInput ? messageInput.value.trim() : "";
        const topic = subject ? `${category}: ${subject}` : category;

        //- Validation checks
        if (!name || !email || !message) {
          // @ts-ignore
          if (typeof window.showToast === "function") {
            // @ts-ignore
            window.showToast({
              type: "error",
              title: "Required Fields",
              message: "Please fill in your name, email, and message before sending.",
            });
          }
          return;
        }

        //- Loading state
        const originalText = submitBtnText ? submitBtnText.textContent : "Submit Inquiry";
        submitBtn.disabled = true;
        submitBtn.classList.add("opacity-75", "cursor-not-allowed");
        if (submitBtnText) {
          submitBtnText.textContent = "Sending...";
        }

        try {
          const response = await fetch("/api/contact", {
            method: "POST",
            headers: {
              "Content-Type": "application/json",
            },
            body: JSON.stringify({
              name: name,
              email: email,
              topic: topic,
              message: message,
            }),
          });

          const data = await response.json().catch(() => ({}));

          if (response.ok && data.success) {
            form.reset();
            // @ts-ignore
            if (typeof window.showToast === "function") {
              // @ts-ignore
              window.showToast({
                type: "success",
                title: "Message Delivered",
                message: data.message || "Thank you for reaching out. Your message has been received.",
              });
            }
          } else {
            // @ts-ignore
            if (typeof window.showToast === "function") {
              // @ts-ignore
              window.showToast({
                type: "error",
                title: "Delivery Problem",
                message: data.error || "We could not deliver your message right now. Please try again.",
              });
            }
          }
        } catch (err) {
          // @ts-ignore
          if (typeof window.showToast === "function") {
            // @ts-ignore
            window.showToast({
              type: "error",
              title: "Network Issue",
              message: "We're having trouble connecting. Please check your internet connection and try again.",
            });
          }
        } finally {
          submitBtn.disabled = false;
          submitBtn.classList.remove("opacity-75", "cursor-not-allowed");
          if (submitBtnText) {
            submitBtnText.textContent = originalText;
          }
        }
      });
    }
  </script>
</Layout>
