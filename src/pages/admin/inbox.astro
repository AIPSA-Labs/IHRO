---
//- Official Council Communications Inbox & Received Inquiries Dashboard
import Layout from "../../layouts/Layout.astro";
import { fetchContactInquiries } from "../../services/db";

export const prerender = false;

const MAX_INQUIRIES_TO_FETCH = 100;
const inquiries = await fetchContactInquiries(MAX_INQUIRIES_TO_FETCH);
---

<Layout>
  <section class="bg-gray-50 text-gray-900 py-16 sm:py-24 px-4 sm:px-6 lg:px-8 w-full min-h-screen">
    <div class="max-w-7xl mx-auto">
      
      {/*- Dashboard Header */}
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 pb-8 border-b border-gray-200 mb-10">
        <div>
          <span class="font-['Inter'] text-xs font-bold tracking-wider text-blue-800 uppercase mb-2 block">
            Staff Portal
          </span>
          <h1 class="font-['Hanken_Grotesk'] text-3xl sm:text-4xl font-bold tracking-tight text-gray-900">
            Received Inquiries & Messages
          </h1>
          <p class="font-['Inter'] text-sm sm:text-base text-gray-600 mt-2">
            Registry of inquiries, advocacy requests, and partnership messages submitted through the website.
          </p>
        </div>

        {/*- Stats Counters */}
        <div class="flex items-center gap-4 shrink-0">
          <div class="bg-white border border-gray-200 rounded-xl p-4 text-center min-w-32 shadow-sm">
            <span class="font-['Hanken_Grotesk'] text-3xl font-bold text-blue-900 block">
              {inquiries.length}
            </span>
            <span class="font-['Inter'] text-xs uppercase tracking-wider text-gray-500 font-semibold mt-1 block">
              Total Inquiries
            </span>
          </div>
          <a
            href="/en/contact"
            class="inline-flex items-center gap-2 px-5 py-3.5 border border-gray-200 bg-white hover:bg-gray-100 rounded-xl text-blue-900 text-xs uppercase tracking-wider font-semibold transition-colors shadow-sm"
          >
            <span class="material-symbols-outlined text-sm">open_in_new</span>
            <span>Contact Form</span>
          </a>
        </div>
      </div>

      {/*- Inquiries List / Table */}
      {inquiries.length === 0 ? (
        <div class="bg-white border border-gray-200 rounded-2xl p-12 text-center shadow-sm">
          <span class="material-symbols-outlined text-4xl text-gray-400 mb-3 block">inbox</span>
          <h3 class="font-['Hanken_Grotesk'] text-2xl font-bold text-gray-900 mb-2">No messages recorded yet</h3>
          <p class="font-['Inter'] text-sm text-gray-600">Incoming submissions from the contact form will appear here automatically.</p>
        </div>
      ) : (
        <div class="space-y-6">
          {inquiries.map((item, index) => {
            const formattedDate = item.created_at
              ? new Date(item.created_at).toLocaleString('en-US', {
                  month: 'short',
                  day: 'numeric',
                  year: 'numeric',
                  hour: '2-digit',
                  minute: '2-digit',
                })
              : 'Recently';

            return (
              <div class="bg-white border border-gray-200 rounded-xl p-6 sm:p-8 shadow-sm hover:border-blue-700 transition-colors">
                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-4 border-b border-gray-100 mb-4">
                  <div class="flex items-center gap-3 flex-wrap">
                    <span class="font-['Hanken_Grotesk'] text-xs font-bold tracking-wider text-yellow-600">
                      #{String(inquiries.length - index).padStart(3, '0')}
                    </span>
                    <span class="inline-block px-3 py-1 text-xs font-semibold rounded-full bg-blue-50 text-blue-900 border border-blue-200">
                      {item.topic || 'General Inquiry'}
                    </span>
                    <span class="inline-block px-3 py-1 text-xs font-semibold rounded-full bg-green-50 text-green-700 border border-green-200">
                      {item.status || 'Pending'}
                    </span>
                  </div>
                  <span class="font-['Inter'] text-xs text-gray-500 flex items-center gap-1.5">
                    <span class="material-symbols-outlined text-sm">schedule</span>
                    {formattedDate}
                  </span>
                </div>

                {/*- Sender Information */}
                <div class="grid sm:grid-cols-2 gap-4 mb-5 pb-4 border-b border-gray-100 text-sm font-['Inter']">
                  <div>
                    <span class="text-xs uppercase tracking-wider text-gray-500 block mb-1 font-medium">Sender Name</span>
                    <span class="font-semibold text-gray-900 text-base">{item.name}</span>
                  </div>
                  <div>
                    <span class="text-xs uppercase tracking-wider text-gray-500 block mb-1 font-medium">Email Address</span>
                    <a href={`mailto:${item.email}`} class="text-blue-700 hover:underline font-medium">
                      {item.email}
                    </a>
                  </div>
                </div>

                {/*- Message Body */}
                <div>
                  <span class="text-xs uppercase tracking-wider text-gray-500 block mb-2 font-medium">Message Content</span>
                  <div class="bg-gray-50 border border-gray-200 rounded-lg p-4 font-['Inter'] text-sm leading-relaxed text-gray-800 whitespace-pre-wrap">
                    {item.message}
                  </div>
                </div>
              </div>
            );
          })}
        </div>
      )}

    </div>
  </section>
</Layout>
