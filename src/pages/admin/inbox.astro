---
//- Official Council Communications Inbox & Received Inquiries Dashboard
import Layout from "../../layouts/Layout.astro";
import { fetchContactInquiries } from "../../services/db";

export const prerender = false;

const inquiries = await fetchContactInquiries(100);
---

<Layout>
  <section class="bg-canvas text-justice-navy py-28 sm:py-36 px-6 sm:px-10 lg:px-16 xl:px-20 w-full min-h-screen border-b border-border">
    <div class="w-full max-w-screen-2xl mx-auto">
      
      {/*- Dashboard Header */}
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 pb-8 border-b border-border mb-10">
        <div>
          <span class="font-['Cinzel'] text-xs font-bold tracking-widest text-royal-blue uppercase mb-2 block">
            Internal Staff & Council Portal
          </span>
          <h1 class="font-['Newsreader'] text-4xl sm:text-5xl font-medium tracking-tight text-justice-navy">
            Received Inquiries & Messages
          </h1>
          <p class="font-['Inter'] text-sm sm:text-base text-on-surface-variant mt-2">
            Live database registry of citizen inquiries, legal defense requests, and partnership submissions.
          </p>
        </div>

        {/*- Stats Counters */}
        <div class="flex items-center gap-4 shrink-0">
          <div class="bg-white border border-border p-4 text-center min-w-[120px] shadow-2xs">
            <span class="font-['Newsreader'] text-3xl font-semibold text-royal-blue block">
              {inquiries.length}
            </span>
            <span class="font-['Inter'] text-[11px] uppercase tracking-wider text-on-surface-variant font-medium mt-0.5 block">
              Total Inquiries
            </span>
          </div>
          <a
            href="/en/contact"
            class="inline-flex items-center gap-2 px-5 py-4 border border-border bg-white hover:bg-canvas-muted text-justice-navy text-xs uppercase tracking-wider font-semibold transition-colors shadow-2xs"
          >
            <span class="material-symbols-outlined text-sm">open_in_new</span>
            <span>Contact Form</span>
          </a>
        </div>
      </div>

      {/*- Inquiries List / Table */}
      {inquiries.length === 0 ? (
        <div class="bg-white border border-border p-12 text-center shadow-2xs">
          <span class="material-symbols-outlined text-4xl text-on-surface-variant/40 mb-3 block">inbox</span>
          <h3 class="font-['Newsreader'] text-2xl font-medium text-justice-navy mb-2">No messages recorded yet</h3>
          <p class="font-['Inter'] text-sm text-on-surface-variant">Incoming submissions from the contact form will appear here automatically.</p>
        </div>
      ) : (
        <div class="space-y-6">
          {inquiries.map((item, index) => {
            const formattedDate = item.created_at
              ? new Date(item.created_at).toLocaleString('en-US', {
                  month: 'short',
                  day: 'numeric',
                  year: 'numeric',
                  hour: '2-digit',
                  minute: '2-digit',
                })
              : 'Recently';

            return (
              <div class="bg-white border border-border p-6 sm:p-8 shadow-2xs hover:border-royal-blue transition-colors">
                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-4 border-b border-border/60 mb-4">
                  <div class="flex items-center gap-3">
                    <span class="font-['Cinzel'] text-xs font-bold tracking-wider text-honor-gold">
                      #{String(inquiries.length - index).padStart(3, '0')}
                    </span>
                    <span class="inline-block px-2.5 py-1 text-[11px] font-semibold uppercase tracking-wider bg-canvas-muted text-royal-blue border border-border/80">
                      {item.topic || 'General Inquiry'}
                    </span>
                    <span class="inline-block px-2.5 py-1 text-[11px] font-semibold uppercase tracking-wider bg-emerald-accent/10 text-emerald-800 border border-emerald-accent/30">
                      {item.status || 'Pending'}
                    </span>
                  </div>
                  <span class="font-['Inter'] text-xs text-on-surface-variant flex items-center gap-1.5">
                    <span class="material-symbols-outlined text-sm">schedule</span>
                    {formattedDate}
                  </span>
                </div>

                {/*- Sender Information */}
                <div class="grid sm:grid-cols-2 gap-4 mb-5 pb-4 border-b border-border/40 text-sm font-['Inter']">
                  <div>
                    <span class="text-xs uppercase tracking-wider text-on-surface-variant block mb-1 font-medium">Sender Name</span>
                    <span class="font-semibold text-justice-navy text-base">{item.name}</span>
                  </div>
                  <div>
                    <span class="text-xs uppercase tracking-wider text-on-surface-variant block mb-1 font-medium">Email Address</span>
                    <a href={`mailto:${item.email}`} class="text-royal-blue hover:underline font-medium">
                      {item.email}
                    </a>
                  </div>
                </div>

                {/*- Message Body */}
                <div>
                  <span class="text-xs uppercase tracking-wider text-on-surface-variant block mb-2 font-medium">Message Content</span>
                  <div class="bg-canvas/50 border border-border/60 p-4 font-['Inter'] text-sm leading-relaxed text-justice-navy whitespace-pre-wrap">
                    {item.message}
                  </div>
                </div>
              </div>
            );
          })}
        </div>
      )}

    </div>
  </section>
</Layout>
