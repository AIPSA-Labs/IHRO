---
import { translations } from "../../locals/home/newsletter";

type Locale = 'en' | 'hi' | 'fr';
const { local = 'en' } = Astro.params ?? {};
const t = translations[local as Locale] || translations['en'];
---

<section class="py-20 bg-white" id="newsletter">

  <div class="max-w-7xl mx-auto px-4 md:px-6">

    <!--//- Main card: dark blue rounded container -->
    <div class="animate-on-scroll scroll-scale bg-blue-900 rounded-2xl p-12 flex flex-col md:flex-row items-center justify-between gap-8 shadow-xl">

      <!--//- Left: heading and subtitle -->
      <div class="text-left max-w-md">
        <h2 class="font-['Hanken_Grotesk'] text-4xl font-bold text-white mb-3">
          {t.title}
        </h2>
        <p class="font-['Inter'] text-white opacity-70">
          {t.subtitle}
        </p>
      </div>

      <!--//- Right: email input + submit button -->
      <form id="homeNewsletterForm" class="w-full md:w-auto flex flex-col sm:flex-row gap-3">
        <input
          id="homeNewsletterEmail"
          type="email"
          placeholder={t.placeholder}
          required
          class="flex-grow md:w-80 p-4 rounded-lg border-none outline-none bg-white/10 text-white placeholder:text-white/60 focus:ring-2 focus:ring-yellow-400"
        />
        <button id="homeNewsletterBtn" type="submit" class="bg-yellow-500 text-white px-8 py-4 rounded-lg font-['Inter'] text-sm font-semibold hover:bg-yellow-400 transition-all active:scale-95 shadow-lg">
          <span id="homeNewsletterBtnText">{t.cta}</span>
        </button>
      </form>

    </div>

  </div>

  <!--//- Multicolor bar strip at section bottom -->
  <div class="mt-12 max-w-7xl mx-auto px-4 md:px-6">
    <div class="colored-bar">
      <span></span>
      <span></span>
      <span></span>
      <span></span>
      <span></span>
    </div>
  </div>

</section>

<script>
  //- Handle homepage newsletter subscription via real AIPSA Database API
  const homeNewsletterForm = document.getElementById("homeNewsletterForm") as HTMLFormElement | null;
  const homeNewsletterEmail = document.getElementById("homeNewsletterEmail") as HTMLInputElement | null;
  const homeNewsletterBtn = document.getElementById("homeNewsletterBtn") as HTMLButtonElement | null;
  const homeNewsletterBtnText = document.getElementById("homeNewsletterBtnText");

  if (homeNewsletterForm && homeNewsletterBtn) {
    homeNewsletterForm.addEventListener("submit", async (e) => {
      e.preventDefault();

      const email = homeNewsletterEmail ? homeNewsletterEmail.value.trim() : "";
      if (!email) {
        return;
      }

      const originalText = homeNewsletterBtnText ? homeNewsletterBtnText.textContent : "Subscribe";
      homeNewsletterBtn.disabled = true;
      homeNewsletterBtn.classList.add("opacity-75", "cursor-not-allowed");
      if (homeNewsletterBtnText) {
        homeNewsletterBtnText.textContent = "...";
      }

      try {
        const response = await fetch("/api/newsletter", {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
          },
          body: JSON.stringify({ email: email }),
        });

        const data = await response.json().catch(() => ({}));

        if (response.ok && data.success) {
          homeNewsletterForm.reset();
          // @ts-ignore
          if (typeof window.showToast === "function") {
            // @ts-ignore
            window.showToast({
              type: "success",
              title: "Subscribed",
              message: data.message || "Thank you for subscribing to IHRO updates.",
            });
          }
        } else {
          // @ts-ignore
          if (typeof window.showToast === "function") {
            // @ts-ignore
            window.showToast({
              type: "error",
              title: "Subscription Notice",
              message: data.error || "We could not process your subscription right now.",
            });
          }
        }
      } catch (err) {
        // @ts-ignore
        if (typeof window.showToast === "function") {
          // @ts-ignore
          window.showToast({
            type: "error",
            title: "Network Issue",
            message: "We're having trouble connecting. Please check your internet connection.",
          });
        }
      } finally {
        homeNewsletterBtn.disabled = false;
        homeNewsletterBtn.classList.remove("opacity-75", "cursor-not-allowed");
        if (homeNewsletterBtnText) {
          homeNewsletterBtnText.textContent = originalText;
        }
      }
    });
  }
</script>
