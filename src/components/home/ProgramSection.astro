---
//- Core programs section with clean minimalist cards, modern icons, and structured layout

import { translations } from "../../locals/home/program";
import { getStrings } from "../../constants/strings";
import { fetchPrograms } from "../../services/db";

type Locale = 'en' | 'hi' | 'fr';
const { local = 'en' } = Astro.params ?? {};
const t = translations[local as Locale] || translations['en'];
const s = getStrings(local);

const dbPrograms = await fetchPrograms();
const displayPrograms = (local === 'en' && dbPrograms.length > 0)
  ? dbPrograms.map((p) => ({
      title: p.title,
      description: p.description,
      icon: p.icon,
    }))
  : t.programs;
---

<section class="py-24 md:py-32 bg-canvas px-6 sm:px-10 lg:px-16 xl:px-20 border-t border-border/80 w-full" id="programs">
  <div class="w-full max-w-screen-2xl mx-auto">
    
    {/*- Section Header */}
    <div class="text-center max-w-3xl mx-auto mb-16 md:mb-20 animate-on-scroll">
      <h2 class="font-['Hanken_Grotesk'] text-3xl sm:text-4xl md:text-5xl font-bold tracking-tight text-justice-navy mb-4">
        {t.title}
      </h2>
      <p class="font-['Inter'] text-base sm:text-lg text-on-surface-variant max-w-2xl mx-auto leading-relaxed">
        {t.subtitle}
      </p>
    </div>

    {/*- Programs Grid */}
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {displayPrograms.map((prog, index) => (
        <div class={`rounded-3xl p-8 transition-all duration-300 flex flex-col justify-between group border animate-on-scroll delay-${index + 1} ${
          index === 0
            ? 'bg-charcoal text-white border-charcoal lg:col-span-2'
            : 'bg-white text-justice-navy border-border/80 hover:shadow-xl'
        }`}>
          <div>
            <div class={`w-14 h-14 rounded-2xl flex items-center justify-center mb-6 transition-colors ${
              index === 0
                ? 'bg-white/10 text-emerald-accent'
                : 'bg-canvas-muted text-royal-blue group-hover:bg-royal-blue group-hover:text-white'
            }`}>
              <span class="material-symbols-outlined text-3xl">{prog.icon}</span>
            </div>
            
            <h3 class="font-['Hanken_Grotesk'] text-2xl font-bold mb-3 tracking-tight">
              {prog.title}
            </h3>
            
            <p class={`font-['Inter'] text-sm sm:text-base leading-relaxed ${
              index === 0 ? 'text-white/80 max-w-xl' : 'text-on-surface-variant'
            }`}>
              {prog.description}
            </p>
          </div>

          <div class="mt-8 pt-6 border-t border-white/10">
            <a
              href={`/${local}/contact?topic=${encodeURIComponent(prog.title.toLowerCase())}`}
              class={`inline-flex items-center gap-2 text-sm font-semibold transition-colors ${
                index === 0 ? 'text-emerald-accent hover:text-white' : 'text-royal-blue hover:text-justice-navy'
              }`}
            >
              <span>{s.pillars.ctaLabel}</span>
              <span class="material-symbols-outlined text-base">arrow_forward</span>
            </a>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>
