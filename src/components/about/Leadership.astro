---
//- Leadership team section with white background and multicolor accents
import { translations } from "../../locals/about/leadership";

type Locale = "en" | "hi" | "fr";
const { local = "en" } = Astro.params ?? {};
const t = translations[local as Locale] || translations["en"];

const BORDER_ACCENTS = [
  "border-t-4 border-t-blue-800",
  "border-t-4 border-t-red-600",
  "border-t-4 border-t-green-700",
  "border-t-4 border-t-yellow-500",
  "border-t-4 border-t-purple-700",
  "border-t-4 border-t-blue-800",
];
---

<section class="bg-white py-24 px-4 md:px-8 border-b border-gray-100 relative overflow-hidden">
  <div class="max-w-7xl mx-auto">

    {/*- Section header */}
    <div class="text-center mb-16">
      <h2 class="animate-on-scroll font-['Hanken_Grotesk'] text-4xl font-bold text-blue-900 mb-4">
        {t.title}
      </h2>
      <div class="w-16 h-1 bg-blue-800 mx-auto rounded-full"></div>
    </div>

    {/*- Team Grid */}
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
      {t.leaders.map((leader, index) => {
        const borderClass = BORDER_ACCENTS[index % BORDER_ACCENTS.length];

        return (
          <div class={`bg-white border border-gray-200 rounded-xl sm:rounded-2xl p-6 sm:p-8 shadow-sm hover:shadow-lg transition-all flex flex-col items-center text-center ${borderClass}`}>
            <div class="w-24 h-24 rounded-full bg-blue-50 border-2 border-blue-100 flex items-center justify-center text-blue-800 mb-6 overflow-hidden">
              <span class="material-symbols-outlined text-5xl">person</span>
            </div>
            <h3 class="font-['Hanken_Grotesk'] text-xl font-bold text-gray-900 mb-1">
              {leader.name}
            </h3>
            <p class="font-['Inter'] text-sm font-medium text-blue-800">
              {leader.position}
            </p>
          </div>
        );
      })}
    </div>

  </div>
</section>
