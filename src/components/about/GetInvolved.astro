---
//- Call to action for volunteers, legal observers, and diplomatic advocates
import { translations } from "../../locals/about/getInvolved";
import { HeartHandshake } from "@lucide/astro";

type Locale = 'en' | 'hi' | 'fr';
const { local = 'en' } = Astro.params ?? {};
const t = translations[local as Locale] || translations['en'];
---

<section class="relative py-24 px-6 sm:px-10 lg:px-16 xl:px-20 overflow-hidden bg-canvas-muted text-justice-navy border-t border-border w-full">
  <div class="w-full max-w-screen-2xl mx-auto text-center relative z-10">
    <h2 class="font-['Newsreader'] text-3xl sm:text-4xl md:text-5xl font-medium mb-4 text-justice-navy">{t.title}</h2>
    <p class="font-['Inter'] text-base text-on-surface-variant mb-8 max-w-2xl mx-auto leading-relaxed">{t.subtitle}</p>
    
    <div class="flex justify-center">
      <a href={`/${local}/contact?role=volunteer`} class="inline-flex items-center justify-center gap-2 px-8 py-3.5 rounded-xs bg-royal-blue hover:bg-royal-blue-dark text-white text-xs font-semibold tracking-wider uppercase transition-colors shadow-2xs border border-royal-blue cursor-pointer">
        <HeartHandshake class="w-4 h-4" />
        <span>{t.cta.volunteer}</span>
      </a>
    </div>
  </div>
</section>
