---
//- Vision and Mission statements structured as official institutional charter mandates
import { translations } from "../../locals/about/missionVision";
import { Target, Eye } from "@lucide/astro";

type Locale = 'en' | 'hi' | 'fr';
const { local = 'en' } = Astro.params ?? {};
const t = translations[local as Locale] || translations['en'];
---

<section class="bg-canvas text-justice-navy py-24 px-6 sm:px-10 lg:px-16 xl:px-20 relative overflow-hidden w-full border-b border-border">
  <div class="w-full max-w-screen-2xl mx-auto grid md:grid-cols-2 gap-10 items-stretch relative z-10">
    
    {/*- Mission Mandate */}
    <div class="bg-white p-8 sm:p-10 border border-border shadow-2xs flex flex-col justify-between">
      <div>
        <div class="flex items-center gap-4 mb-6 pb-4 border-b border-border/60">
          <div class="p-3 border border-border bg-canvas-muted text-royal-blue">
            <Target class="w-6 h-6" />
          </div>
          <h2 class="font-['Newsreader'] text-2xl sm:text-3xl font-semibold text-justice-navy">{t.mission.title}</h2>
        </div>
        <p class="font-['Inter'] text-sm sm:text-base text-on-surface-variant leading-relaxed">{t.mission.description}</p>
      </div>
    </div>

    {/*- Vision Mandate */}
    <div class="bg-white p-8 sm:p-10 border border-border shadow-2xs flex flex-col justify-between">
      <div>
        <div class="flex items-center gap-4 mb-6 pb-4 border-b border-border/60">
          <div class="p-3 border border-border bg-canvas-muted text-royal-blue">
            <Eye class="w-6 h-6" />
          </div>
          <h2 class="font-['Newsreader'] text-2xl sm:text-3xl font-semibold text-justice-navy">{t.vision.title}</h2>
        </div>
        <p class="font-['Inter'] text-sm sm:text-base text-on-surface-variant leading-relaxed">{t.vision.description}</p>
      </div>
    </div>

  </div>
</section>
