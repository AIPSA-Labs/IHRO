---
//- Leadership and international diplomatic council members
import { translations } from "../../locals/about/leadership";

type Locale = 'en' | 'hi' | 'fr';
const { local = 'en' } = Astro.params ?? {};
const t = translations[local as Locale] || translations['en'];
---

<section id="leadership" class="bg-canvas text-justice-navy py-24 px-6 sm:px-10 lg:px-16 xl:px-20 relative overflow-hidden w-full border-b border-border scroll-mt-20">
  <div class="w-full max-w-screen-2xl mx-auto relative z-10">
    <div class="text-center mb-16">
      <h2 class="font-['Newsreader'] text-3xl sm:text-4xl md:text-5xl font-medium mb-4 text-justice-navy">{t.title}</h2>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6">
      {t.leaders.map((leader) => (
        <div class="bg-white border border-border p-6 flex flex-col items-center text-center shadow-2xs hover:border-royal-blue transition-colors group">
          <div class="relative mb-4 p-1 border border-border bg-canvas-muted">
            <img src={leader.image} alt={leader.name} class="w-32 h-32 object-cover" />
          </div>
          <h3 class="font-['Newsreader'] text-xl font-semibold text-justice-navy group-hover:text-royal-blue transition-colors">{leader.name}</h3>
          <p class="font-['Inter'] text-xs uppercase tracking-wider text-on-surface-variant mt-1 font-medium">{leader.position}</p>
        </div>
      ))}
    </div>
  </div>
</section>
