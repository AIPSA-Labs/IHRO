---
//- Testimonials carousel section with smooth scrolling, compact responsive cards for mobile (3 cards visible), and spacious desktop layout
import { translations } from "../../locals/home/testimonials";

type Locale = "en" | "hi" | "fr";
const { local = "en" } = Astro.params ?? {};
const t = translations[local as Locale] || translations["en"];

//- Cycling colors for quote marks and avatar backgrounds
const QUOTE_COLORS = ["text-blue-800", "text-red-600", "text-green-700", "text-yellow-500", "text-purple-700"];
const AVATAR_COLORS = ["bg-blue-800", "bg-red-600", "bg-green-700", "bg-yellow-500", "bg-purple-700"];
---

<section class="py-16 md:py-24 bg-gray-50 overflow-hidden border-b border-gray-100" id="global-voices">

  {/*- Section header */}
  <div class="max-w-7xl mx-auto px-4 md:px-8 mb-10 md:mb-16 text-center">
    <h2 class="animate-on-scroll font-['Hanken_Grotesk'] text-3xl sm:text-4xl md:text-5xl font-bold text-blue-900 mb-3 md:mb-4">
      {t.title}
    </h2>
    <p class="animate-on-scroll delay-1 text-gray-500 max-w-xl mx-auto font-['Inter'] text-sm md:text-base">
      {t.subtitle}
    </p>
  </div>

  {/*- Scrolling testimonials track */}
  <div class="relative w-full">
    <div class="animate-scroll gap-2 sm:gap-4 md:gap-6 px-2 md:px-4">

      {/*- Testimonial Set 1 */}
      <div class="flex gap-2 sm:gap-4 md:gap-6">
        {t.testimonials.map((testimonial, index) => (
          <div class="w-28 sm:w-36 md:w-80 lg:w-96 bg-white shadow-sm hover:shadow-md transition-shadow rounded-xl md:rounded-2xl p-3 md:p-8 border border-gray-200 flex flex-col justify-between shrink-0">
            {/*- Opening quote mark in cycling color */}
            <div>
              <span class={`font-['Hanken_Grotesk'] text-2xl md:text-5xl font-bold leading-none ${QUOTE_COLORS[index % QUOTE_COLORS.length]}`}>
                &ldquo;
              </span>
              <p class="italic text-gray-700 font-['Inter'] mt-1 md:mt-2 text-xs md:text-sm leading-snug md:leading-relaxed line-clamp-3 md:line-clamp-none">
                {testimonial.quote}
              </p>
            </div>
            {/*- Avatar + name + role */}
            <div class="flex items-center gap-2 md:gap-4 mt-3 md:mt-8 pt-2 md:pt-4 border-t border-gray-100">
              <div class={`w-6 h-6 md:w-10 md:h-10 rounded-full flex items-center justify-center text-white font-bold text-xs md:text-sm shrink-0 ${AVATAR_COLORS[index % AVATAR_COLORS.length]}`}>
                {testimonial.name.charAt(0).toUpperCase()}
              </div>
              <div class="min-w-0">
                <h4 class="font-['Inter'] text-xs md:text-sm font-semibold text-gray-900 truncate">{testimonial.name}</h4>
                <p class="text-xs text-gray-500 font-['Inter'] truncate">{testimonial.role}</p>
              </div>
            </div>
          </div>
        ))}
      </div>

      {/*- Duplicate set for seamless infinite loop */}
      <div aria-hidden="true" class="flex gap-2 sm:gap-4 md:gap-6">
        {t.testimonials.map((testimonial, index) => (
          <div class="w-28 sm:w-36 md:w-80 lg:w-96 bg-white shadow-sm hover:shadow-md transition-shadow rounded-xl md:rounded-2xl p-3 md:p-8 border border-gray-200 flex flex-col justify-between shrink-0">
            {/*- Opening quote mark in cycling color */}
            <div>
              <span class={`font-['Hanken_Grotesk'] text-2xl md:text-5xl font-bold leading-none ${QUOTE_COLORS[index % QUOTE_COLORS.length]}`}>
                &ldquo;
              </span>
              <p class="italic text-gray-700 font-['Inter'] mt-1 md:mt-2 text-xs md:text-sm leading-snug md:leading-relaxed line-clamp-3 md:line-clamp-none">
                {testimonial.quote}
              </p>
            </div>
            {/*- Avatar + name + role */}
            <div class="flex items-center gap-2 md:gap-4 mt-3 md:mt-8 pt-2 md:pt-4 border-t border-gray-100">
              <div class={`w-6 h-6 md:w-10 md:h-10 rounded-full flex items-center justify-center text-white font-bold text-xs md:text-sm shrink-0 ${AVATAR_COLORS[index % AVATAR_COLORS.length]}`}>
                {testimonial.name.charAt(0).toUpperCase()}
              </div>
              <div class="min-w-0">
                <h4 class="font-['Inter'] text-xs md:text-sm font-semibold text-gray-900 truncate">{testimonial.name}</h4>
                <p class="text-xs text-gray-500 font-['Inter'] truncate">{testimonial.role}</p>
              </div>
            </div>
          </div>
        ))}
      </div>

    </div>
  </div>

</section>
