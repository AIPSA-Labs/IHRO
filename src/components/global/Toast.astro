---
//- Global Toast Notification Component
---

<div
  id="toast-container"
  class="fixed top-20 right-4 z-50 flex flex-col gap-3 max-w-sm w-full pointer-events-none px-4 sm:px-0"
  aria-live="polite"
  aria-atomic="true"
></div>

<script>
  //- Toast duration constant to avoid magic numbers
  const DEFAULT_TOAST_DURATION_MS = 4500;
  const FADE_OUT_ANIMATION_MS = 300;

  interface ToastOptions {
    type?: "success" | "error" | "info";
    title?: string;
    message: string;
    duration?: number;
  }

  //- Global toast dispatcher
  // @ts-ignore
  window.showToast = function (options: ToastOptions) {
    const container = document.getElementById("toast-container");
    if (!container) {
      return;
    }

    const type = options.type || "info";
    const title = options.title || (type === "success" ? "Success" : type === "error" ? "Notice" : "Information");
    const message = options.message || "";
    const duration = options.duration || DEFAULT_TOAST_DURATION_MS;

    //- Visual configuration per toast type
    const typeConfig = {
      success: {
        border: "border-l-4 border-l-green-600",
        iconBg: "bg-green-50 text-green-700",
        iconName: "check_circle",
      },
      error: {
        border: "border-l-4 border-l-red-600",
        iconBg: "bg-red-50 text-red-600",
        iconName: "error",
      },
      info: {
        border: "border-l-4 border-l-blue-800",
        iconBg: "bg-blue-50 text-blue-800",
        iconName: "info",
      },
    }[type];

    //- Create toast element
    const toast = document.createElement("div");
    toast.className = `bg-white border border-gray-200 ${typeConfig.border} rounded-xl shadow-xl p-4 flex items-start gap-3 pointer-events-auto transform translate-y-2 opacity-0 transition-all duration-300 ease-out`;

    toast.innerHTML = `
      <div class="w-8 h-8 rounded-lg ${typeConfig.iconBg} flex items-center justify-center shrink-0">
        <span class="material-symbols-outlined text-xl leading-none">${typeConfig.iconName}</span>
      </div>
      <div class="flex-1 min-w-0 pt-0.5">
        <h4 class="font-['Hanken_Grotesk'] text-sm font-bold text-gray-900 leading-tight mb-1">${title}</h4>
        <p class="font-['Inter'] text-xs text-gray-600 leading-relaxed">${message}</p>
      </div>
      <button
        type="button"
        aria-label="Close notification"
        class="text-gray-400 hover:text-gray-600 p-1 rounded-md hover:bg-gray-100 transition-colors cursor-pointer shrink-0"
      >
        <span class="material-symbols-outlined text-base leading-none">close</span>
      </button>
    `;

    //- Close button event listener
    const closeBtn = toast.querySelector("button");
    const removeToast = () => {
      toast.classList.remove("translate-y-0", "opacity-100");
      toast.classList.add("translate-y-2", "opacity-0");
      setTimeout(() => {
        if (toast.parentElement) {
          toast.remove();
        }
      }, FADE_OUT_ANIMATION_MS);
    };

    if (closeBtn) {
      closeBtn.addEventListener("click", removeToast);
    }

    container.appendChild(toast);

    //- Animate in on next tick
    requestAnimationFrame(() => {
      toast.classList.remove("translate-y-2", "opacity-0");
      toast.classList.add("translate-y-0", "opacity-100");
    });

    //- Auto dismiss
    setTimeout(removeToast, duration);
  };
</script>
