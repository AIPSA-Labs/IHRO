---
//- Global network and diplomatic presence directory featuring structured official delegations and cartographic map showcase

import { translations } from "../../locals/home/presence";
import { getStrings } from "../../constants/strings";
import digitalMap from "../../assets/digital-map.png";

type Locale = 'en' | 'hi' | 'fr';
const { local = 'en' } = Astro.params ?? {};
const t = translations[local as Locale] || translations['en'];
const s = getStrings(local);
---

<section class="py-24 md:py-32 bg-canvas px-6 sm:px-10 lg:px-16 xl:px-20 overflow-hidden border-b border-border w-full" id="presence">
  <div class="w-full max-w-screen-2xl mx-auto">
    
    {/*- Section Header */}
    <div class="text-center max-w-3xl mx-auto mb-16 md:mb-20">
      <h2 class="font-['Newsreader'] text-3xl sm:text-4xl md:text-5xl font-medium tracking-tight text-justice-navy mb-4">
        {s.presence.title}
      </h2>
      <p class="font-['Inter'] text-base text-on-surface-variant max-w-2xl mx-auto leading-relaxed">
        {s.presence.subtitle}
      </p>
    </div>

    {/*- Two Column Details: Structured Diplomatic Directory & Archival Map Frame */}
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">
      
      {/*- Left Column: Diplomatic Directory */}
      <div class="lg:col-span-5 divide-y divide-border border-y border-border bg-white p-6 sm:p-8 shadow-2xs">
        
        {/*- International Delegations */}
        <div class="pb-6">
          <h3 class="font-['Cinzel'] text-xs font-bold text-royal-blue uppercase tracking-wider mb-2 flex items-center gap-2">
            <span class="material-symbols-outlined text-base">public</span>
            <span>{t.internationalTitle}</span>
          </h3>
          <p class="font-['Inter'] text-sm sm:text-base text-justice-navy font-medium leading-relaxed">
            {t.internationalOffices.map((office) => office.country).join(' · ')}
          </p>
        </div>

        {/*- National Chapters */}
        <div class="py-6">
          <h3 class="font-['Cinzel'] text-xs font-bold text-emerald-accent uppercase tracking-wider mb-2 flex items-center gap-2">
            <span class="material-symbols-outlined text-base">flag</span>
            <span>{t.nationalTitle}</span>
          </h3>
          <p class="font-['Inter'] text-sm sm:text-base text-justice-navy font-medium leading-relaxed">
            {t.nationalChapters.join(' · ')}
          </p>
        </div>

        {/*- Regional Councils */}
        <div class="pt-6">
          <h3 class="font-['Cinzel'] text-xs font-bold text-on-surface-variant uppercase tracking-wider mb-2 flex items-center gap-2">
            <span class="material-symbols-outlined text-base">apartment</span>
            <span>{t.stateTitle}</span>
          </h3>
          <p class="font-['Inter'] text-sm text-on-surface-variant leading-relaxed">
            {t.stateChapters.join(' · ')}
          </p>
        </div>

      </div>

      {/*- Right Column: Archival Cartographic Map Frame */}
      <div class="lg:col-span-7 relative p-2 bg-white border border-border shadow-2xs">
        <div class="relative w-full h-80 sm:h-96 overflow-hidden border border-border/60 bg-canvas-muted">
          <img
            src={digitalMap.src}
            alt={s.presence.title}
            class="w-full h-full object-cover object-center"
          />
        </div>
      </div>

    </div>

  </div>
</section>
