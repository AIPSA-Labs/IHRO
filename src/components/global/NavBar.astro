---
//- Transparent navigation bar matching the reference design layout with IHRO brand, centered links, language circle, and donate pill

import { getStrings } from "../../constants/strings";
import { supportedLocales } from "../../locals/languages";

const { local = "en" } = Astro.params;
const s = getStrings(local);

//- Extract current sub-path without locale prefix so language switcher preserves the active page
const pathname = Astro.url.pathname;
const cleanPath = pathname.replace(/^\/(en|hi|fr)/, '') || '';
---

<header class="fixed top-0 left-0 right-0 z-50 bg-canvas/90 backdrop-blur-xs transition-colors w-full">
  <div class="w-full px-6 sm:px-10 lg:px-16 xl:px-20">
    <div class="flex items-center justify-between h-20">

      {/*- IHRO Brand Identity */}
      <a href={`/${local}/`} class="flex items-center gap-3 cursor-pointer group">
        <img src="/favicon.svg" alt={s.brand.name} class="h-10 w-10 object-contain" />
        <div class="flex flex-col">
          <span class="font-['Hanken_Grotesk'] text-xl font-bold text-justice-navy leading-none tracking-tight">
            {s.brand.name}
          </span>
          <span class="hidden sm:inline font-['Inter'] text-xs text-on-surface-variant font-medium mt-1">
            {s.brand.fullName}
          </span>
        </div>
      </a>

      {/*- Centered Desktop Navigation */}
      <nav class="hidden lg:flex items-center gap-6 xl:gap-8">
        <a href={`/${local}/`} class="text-sm font-medium text-justice-navy hover:text-black transition-colors">
          {s.nav.home}
        </a>
        <a href={`/${local}/about`} class="text-sm font-medium text-justice-navy hover:text-black transition-colors">
          {s.nav.about}
        </a>
        <a href={`/${local}/#mission`} class="text-sm font-medium text-justice-navy hover:text-black transition-colors">
          {s.nav.mission}
        </a>

        {/*- Interactive Programs Dropdown */}
        <div class="relative group">
          <a
            href={`/${local}/about#policies`}
            class="flex items-center gap-1 text-sm font-medium text-justice-navy hover:text-black transition-colors cursor-pointer py-2"
          >
            <span>{s.nav.programs}</span>
            <span class="material-symbols-outlined text-base transition-transform group-hover:rotate-180">expand_more</span>
          </a>

          {/*- Dropdown Menu */}
          <div class="invisible group-hover:visible opacity-0 group-hover:opacity-100 transition-all duration-200 absolute left-0 mt-1 w-64 bg-white border border-border rounded-2xl shadow-xl py-3 z-50">
            <a
              href={`/${local}/about#policies`}
              class="block px-4 py-2 text-xs font-semibold text-justice-navy hover:bg-canvas-muted hover:text-royal-blue transition-colors"
            >
              Advocacy & Defense
            </a>
            <a
              href={`/${local}/contact?topic=legal-aid`}
              class="block px-4 py-2 text-xs font-semibold text-justice-navy hover:bg-canvas-muted hover:text-royal-blue transition-colors"
            >
              Legal Aid & Representation
            </a>
            <a
              href={`/${local}/about#policies`}
              class="block px-4 py-2 text-xs font-semibold text-justice-navy hover:bg-canvas-muted hover:text-royal-blue transition-colors"
            >
              Education & Human Rights Training
            </a>
            <a
              href={`/${local}/about#policies`}
              class="block px-4 py-2 text-xs font-semibold text-justice-navy hover:bg-canvas-muted hover:text-royal-blue transition-colors"
            >
              Environmental Justice
            </a>
            <a
              href={`/${local}/contact?topic=community`}
              class="block px-4 py-2 text-xs font-semibold text-justice-navy hover:bg-canvas-muted hover:text-royal-blue transition-colors"
            >
              Community Defense & Aid
            </a>
          </div>
        </div>

        <a href={`/${local}/about#leadership`} class="text-sm font-medium text-justice-navy hover:text-black transition-colors">
          {s.nav.presence}
        </a>
        <a href={`/${local}/contact`} class="text-sm font-medium text-justice-navy hover:text-black transition-colors">
          {s.nav.contact}
        </a>
      </nav>

      {/*- Right Actions: Language Circle and Dark Pill CTA */}
      <div class="flex items-center gap-3">
        {/*- Circular Language Selector Button */}
        <div class="relative">
          <button
            id="navLangButton"
            class="w-9 h-9 rounded-full bg-charcoal text-white flex items-center justify-center hover:bg-black transition-colors cursor-pointer shadow-xs"
            aria-label={s.nav.language}
          >
            <span class="material-symbols-outlined text-base">translate</span>
          </button>
          
          <div
            id="navLangMenu"
            class="hidden absolute right-0 mt-2 w-36 bg-white border border-border rounded-2xl shadow-xl py-2 z-50 animate-in"
          >
            {supportedLocales.map((loc) => (
              <a
                href={`/${loc.code}${cleanPath}`}
                class={`block px-4 py-2 text-xs font-medium transition-colors ${
                  loc.code === local ? 'bg-royal-blue text-white font-semibold' : 'text-justice-navy hover:bg-canvas-muted'
                }`}
              >
                {loc.label}
              </a>
            ))}
          </div>
        </div>

        {/*- Dark Pill CTA Button */}
        <a
          href={`/${local}/contact?type=donate`}
          class="hidden sm:inline-flex items-center justify-center px-6 py-2.5 rounded-full bg-charcoal hover:bg-black text-white text-sm font-semibold shadow-xs transition-colors cursor-pointer"
        >
          {s.nav.donateNow}
        </a>

        {/*- Mobile Drawer Toggle Button */}
        <button
          class="lg:hidden p-2 rounded-full text-justice-navy hover:bg-black/5 transition-colors cursor-pointer"
          onclick="toggleDrawer()"
          aria-label={s.nav.home}
        >
          <span class="material-symbols-outlined text-2xl">menu</span>
        </button>
      </div>

    </div>
  </div>
</header>

<script>
  //- Dropdown toggle for language menu
  const langButton = document.getElementById('navLangButton');
  const langMenu = document.getElementById('navLangMenu');

  if (langButton && langMenu) {
    langButton.addEventListener('click', (e) => {
      e.stopPropagation();
      langMenu.classList.toggle('hidden');
    });

    document.addEventListener('click', () => {
      if (!langMenu.classList.contains('hidden')) {
        langMenu.classList.add('hidden');
      }
    });
  }

  //- Drawer toggle function on window
  // @ts-ignore
  window.toggleDrawer = function() {
    const drawer = document.getElementById('drawer');
    if (drawer) {
      drawer.classList.toggle('-translate-y-full');
      drawer.classList.toggle('translate-y-0');
    }
  };
</script>
