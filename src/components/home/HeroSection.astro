---
//- Hero section featuring official diplomatic UN aesthetic with authoritative serif typography, structured charter badge, archival framed showcase, and live impact registry

import { getStrings } from "../../constants/strings";
import { CONFIG } from "../../constants/config";
import heroImg from "../../assets/hero.png";

const { local = "en" } = Astro.params;
const s = getStrings(local);
---

<section class="relative pt-24 md:pt-32 pb-16 bg-canvas overflow-hidden w-full flex flex-col items-center border-b border-border">
  <div class="w-full max-w-screen-2xl mx-auto px-6 sm:px-10 lg:px-16 xl:px-20 text-center">
    
    {/*- Main Hero Copy & CTAs */}
    <div class="max-w-4xl mx-auto mb-10">
      <h1 class="font-['Newsreader'] text-4xl sm:text-6xl md:text-7xl font-medium tracking-tight text-justice-navy leading-[1.08] mb-5">
        <span class="block">{s.hero.titleLine1}</span>
        <span class="block italic font-normal text-royal-blue">{s.hero.titleLine2}</span>
      </h1>

      <p class="font-['Inter'] text-sm sm:text-base md:text-lg text-on-surface-variant max-w-2xl mx-auto leading-relaxed mb-8">
        {s.hero.subtitle}
      </p>

      <div class="flex flex-wrap items-center justify-center gap-4 relative z-20">
        <a
          href={`/${local}/contact`}
          class="inline-flex items-center justify-center px-8 py-3.5 rounded-xs bg-royal-blue hover:bg-royal-blue-dark text-white text-xs font-semibold tracking-wider uppercase shadow-2xs transition-colors cursor-pointer border border-royal-blue"
        >
          {s.hero.ctaPrimary}
        </a>
        <a
          href="#mission"
          class="inline-flex items-center justify-center px-8 py-3.5 rounded-xs bg-white hover:bg-canvas-muted text-justice-navy text-xs font-semibold tracking-wider uppercase transition-colors cursor-pointer border border-border shadow-2xs"
        >
          {s.hero.ctaSecondary}
        </a>
      </div>
    </div>

    {/*- Archival Framed Diplomatic Visual Showcase */}
    <div class="w-full max-w-5xl mx-auto relative z-10 p-2 sm:p-3 bg-white border border-border shadow-sm">
      <div class="relative w-full h-72 sm:h-96 md:h-[28rem] overflow-hidden border border-border/60">
        <img
          src={heroImg.src}
          alt={s.hero.altArtwork}
          class="w-full h-full object-cover object-center"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-black/40 via-transparent to-transparent pointer-events-none"></div>
      </div>
    </div>

    {/*- Unified Live Global Impact Registry Strip */}
    <div class="w-full max-w-5xl mx-auto mt-10 pt-8 border-t border-border grid grid-cols-2 md:grid-cols-4 gap-y-6 md:gap-y-0 md:divide-x divide-border">
      <div class="py-2 px-4 text-center">
        <span id="heroStatNations" class="font-['Newsreader'] text-3xl sm:text-4xl font-semibold text-royal-blue block">
          {CONFIG.STATS.NATIONS_COUNT}+
        </span>
        <span class="font-['Inter'] text-[11px] uppercase tracking-wider text-on-surface-variant font-medium mt-1 block">
          {s.presence.stats.nations}
        </span>
      </div>
      <div class="py-2 px-4 text-center">
        <span id="heroStatChapters" class="font-['Newsreader'] text-3xl sm:text-4xl font-semibold text-emerald-accent block">
          {CONFIG.STATS.CHAPTERS_COUNT}+
        </span>
        <span class="font-['Inter'] text-[11px] uppercase tracking-wider text-on-surface-variant font-medium mt-1 block">
          {s.presence.stats.chapters}
        </span>
      </div>
      <div class="py-2 px-4 text-center">
        <span id="heroStatCases" class="font-['Newsreader'] text-3xl sm:text-4xl font-semibold text-justice-navy block">
          {CONFIG.STATS.CASES_SUPPORTED.toLocaleString()}+
        </span>
        <span class="font-['Inter'] text-[11px] uppercase tracking-wider text-on-surface-variant font-medium mt-1 block">
          {s.presence.stats.cases}
        </span>
      </div>
      <div class="py-2 px-4 text-center">
        <span id="heroStatVolunteers" class="font-['Newsreader'] text-3xl sm:text-4xl font-semibold text-royal-blue block">
          {CONFIG.STATS.VOLUNTEERS_COUNT.toLocaleString()}+
        </span>
        <span class="font-['Inter'] text-[11px] uppercase tracking-wider text-on-surface-variant font-medium mt-1 block">
          {s.presence.stats.volunteers}
        </span>
      </div>
    </div>

  </div>
</section>

<script>
  //- Sync hero metrics with live server endpoint /api/stats
  fetch('/api/stats')
    .then((res) => {
      if (res.ok) {
        return res.json();
      }
      return null;
    })
    .then((data) => {
      if (data && data.success && data.stats) {
        const nationsEl = document.getElementById('heroStatNations');
        const chaptersEl = document.getElementById('heroStatChapters');
        const casesEl = document.getElementById('heroStatCases');
        const volunteersEl = document.getElementById('heroStatVolunteers');
        if (nationsEl) {
          nationsEl.textContent = `${data.stats.nations}+`;
        }
        if (chaptersEl) {
          chaptersEl.textContent = `${data.stats.chapters}+`;
        }
        if (casesEl) {
          casesEl.textContent = `${data.stats.casesSupported.toLocaleString()}+`;
        }
        if (volunteersEl) {
          volunteersEl.textContent = `${data.stats.volunteers.toLocaleString()}+`;
        }
      }
    })
    .catch((err) => {
      console.error("[IHRO Hero Stats Sync Error]", err);
    });
</script>
