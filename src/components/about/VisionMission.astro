---
//- Vision and Mission statements styled in modern humanitarian theme with coral icons and rounded cards

import { translations } from "../../locals/about/missionVision";

type Locale = 'en' | 'hi' | 'fr';
const { local = 'en' } = Astro.params ?? {};
const t = translations[local as Locale] || translations['en'];
---

<section class="bg-white text-zinc-900 py-20 md:py-28 px-6 sm:px-10 lg:px-16 xl:px-20 relative overflow-hidden w-full border-b border-gray-100">
  <div class="w-full max-w-screen-2xl mx-auto grid md:grid-cols-2 gap-8 items-stretch relative z-10">
    
    {/*- Mission Mandate */}
    <div class="bg-gray-50 p-8 sm:p-10 rounded-2xl border border-gray-100 shadow-sm flex flex-col justify-between animate-on-scroll">
      <div>
        <div class="flex items-center gap-4 mb-6 pb-4 border-b border-gray-200">
          <div class="p-3 rounded-xl bg-coral/10 text-coral">
            <span class="material-symbols-outlined text-2xl">track_changes</span>
          </div>
          <h2 class="font-['Newsreader'] text-2xl sm:text-3xl font-bold text-zinc-900">{t.mission.title}</h2>
        </div>
        <p class="font-['Inter'] text-sm sm:text-base text-zinc-600 leading-relaxed font-normal">{t.mission.description}</p>
      </div>
    </div>

    {/*- Vision Mandate */}
    <div class="bg-gray-50 p-8 sm:p-10 rounded-2xl border border-gray-100 shadow-sm flex flex-col justify-between animate-on-scroll delay-150">
      <div>
        <div class="flex items-center gap-4 mb-6 pb-4 border-b border-gray-200">
          <div class="p-3 rounded-xl bg-coral/10 text-coral">
            <span class="material-symbols-outlined text-2xl">visibility</span>
          </div>
          <h2 class="font-['Newsreader'] text-2xl sm:text-3xl font-bold text-zinc-900">{t.vision.title}</h2>
        </div>
        <p class="font-['Inter'] text-sm sm:text-base text-zinc-600 leading-relaxed font-normal">{t.vision.description}</p>
      </div>
    </div>

  </div>
</section>
