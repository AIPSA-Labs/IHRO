---
//- Core humanitarian focus cards: "Helping The Vulnerable, Your Support Matters" matching the reference design layout

import { getStrings } from "../../constants/strings";

const { local = "en" } = Astro.params;
const s = getStrings(local);

const DELAYS = ["delay-100", "delay-200", "delay-300", "delay-400"];
---

<section class="pt-16 pb-20 md:pt-20 md:pb-28 bg-white text-zinc-900 border-b border-gray-100 w-full" id="vulnerable">
  <div class="w-full max-w-screen-2xl mx-auto px-6 sm:px-10 lg:px-16 xl:px-20">
    
    {/*- Centered Section Header */}
    <div class="text-center max-w-2xl mx-auto mb-14 md:mb-18 animate-on-scroll">
      <h2 class="font-['Newsreader'] text-3xl sm:text-4xl md:text-5xl font-bold tracking-tight text-zinc-900 mb-4">
        {s.vulnerable.title}
      </h2>
      <p class="font-['Inter'] text-sm sm:text-base text-zinc-600 leading-relaxed font-normal">
        {s.vulnerable.subtitle}
      </p>
    </div>

    {/*- 4-Card Horizontal Grid */}
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 md:gap-8">
      {s.vulnerable.cards.map((card, index) => (
        <a
          href={`/${local}/contact?topic=${encodeURIComponent(card.category.toLowerCase())}`}
          class={`group flex flex-col items-center text-center cursor-pointer animate-on-scroll ${DELAYS[index % 4]}`}
        >
          {/*- Card Image with Rounded Corners */}
          <div class="w-full aspect-[4/3] rounded-2xl overflow-hidden mb-4 bg-gray-100 shadow-sm border border-gray-100">
            <img
              src={card.image}
              alt={card.title}
              class="w-full h-full object-cover"
              loading="lazy"
            />
          </div>

          {/*- Category Pill */}
          <span class="text-[11px] font-bold uppercase tracking-wider text-coral mb-1">
            {card.category}
          </span>

          {/*- Card Title */}
          <h3 class="font-['Newsreader'] text-xl font-bold text-zinc-900 group-hover:text-coral transition-colors">
            {card.title}
          </h3>
        </a>
      ))}
    </div>

  </div>
</section>
