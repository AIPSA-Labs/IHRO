---
//- About page Hero section with deep blue background, breadcrumb, and multicolor accent strip
import { translations } from "../../locals/about/hero";

type Locale = "en" | "hi" | "fr";
const { local = "en" } = Astro.params ?? {};
const t = translations[local as Locale] || translations["en"];
---

<section class="relative bg-blue-900 text-white pt-24 pb-16 px-4 md:px-8 overflow-hidden">
  {/*- Background subtle circles */}
  <div class="absolute top-0 left-0 w-80 h-80 bg-blue-800 rounded-full blur-3xl opacity-30 pointer-events-none -translate-x-1/2 -translate-y-1/2"></div>
  <div class="absolute bottom-0 right-0 w-80 h-80 bg-blue-700 rounded-full blur-3xl opacity-20 pointer-events-none translate-x-1/2 translate-y-1/2"></div>

  <div class="max-w-4xl mx-auto text-center relative z-10">

    {/*- Breadcrumb */}
    <nav class="flex justify-center items-center gap-2 text-xs uppercase tracking-wider text-blue-200 mb-6 font-medium">
      <a href={`/${local}/`} class="hover:text-white transition-colors">Home</a>
      <span class="text-blue-400">/</span>
      <span class="text-white">About</span>
    </nav>

    {/*- Title */}
    <h1 class="animate-on-scroll delay-1 font-['Hanken_Grotesk'] text-4xl sm:text-5xl md:text-6xl font-bold mb-6 leading-tight tracking-tight">
      {t.title}
    </h1>

    {/*- Subtitle */}
    <p class="animate-on-scroll delay-2 font-['Inter'] text-lg sm:text-xl text-blue-100 mb-6 leading-relaxed max-w-2xl mx-auto font-medium">
      {t.subtitle}
    </p>

    {/*- Description */}
    <p class="animate-on-scroll delay-3 font-['Inter'] text-base text-blue-200 max-w-3xl mx-auto leading-relaxed">
      {t.description}
    </p>

  </div>

  {/*- Multicolor bar divider at hero bottom */}
  <div class="colored-bar absolute bottom-0 left-0 right-0">
    <span></span><span></span><span></span><span></span><span></span>
  </div>
</section>
