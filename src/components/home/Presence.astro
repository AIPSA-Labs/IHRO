---
//- Large rounded humanitarian video impact banner and dark partner coalition strip matching the reference design layout

import { getStrings } from "../../constants/strings";

const { local = "en" } = Astro.params;
const s = getStrings(local);

const PARTNERS = [
  { name: "Global Human Rights Coalition", icon: "policy" },
  { name: "UN Civil Society Alliance", icon: "public" },
  { name: "International Peace Council", icon: "balance" },
  { name: "European Rights Foundation", icon: "gavel" },
  { name: "Red Cross Partner Network", icon: "health_and_safety" },
  { name: "Humanitarian Relief Forum", icon: "diversity_1" },
];
---

<section class="py-16 md:py-24 bg-white text-zinc-900 w-full" id="impact-media">
  <div class="w-full max-w-screen-2xl mx-auto px-6 sm:px-10 lg:px-16 xl:px-20">
    
    {/*- Large Rounded Video / Media Banner */}
    <div class="relative w-full aspect-[16/9] md:aspect-[21/9] rounded-3xl overflow-hidden shadow-2xl bg-charcoal-dark mb-16 border border-gray-100 animate-on-scroll scroll-scale">
      <img
        src="https://images.pexels.com/photos/6646918/pexels-photo-6646918.jpeg?auto=compress&cs=tinysrgb&w=1600"
        alt={s.videoBanner.title}
        class="w-full h-full object-cover object-center"
        loading="lazy"
      />
      
      {/*- Gradient overlay */}
      <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/40 to-black/20 flex flex-col items-center justify-center p-6 text-center">
        {/*- Play Button with Animated Ring */}
        <button
          class="relative group cursor-pointer mb-5"
          aria-label={s.videoBanner.playLabel}
          onclick="alert('IHRO Humanitarian Documentary: Defending Rights Across 45+ Nations.')"
        >
          <div class="w-20 h-20 sm:w-24 sm:h-24 rounded-full bg-white/20 backdrop-blur-md flex items-center justify-center border-2 border-white/60 group-hover:bg-coral group-hover:border-coral transition-colors duration-300 shadow-xl">
            <span class="material-symbols-outlined text-3xl sm:text-4xl text-white ml-1">play_arrow</span>
          </div>
          <span class="absolute -inset-2 rounded-full border border-white/30 animate-ping pointer-events-none"></span>
        </button>

        <h3 class="font-['Newsreader'] text-2xl sm:text-3xl md:text-4xl font-bold text-white max-w-2xl leading-tight mb-2">
          {s.videoBanner.title}
        </h3>
        <p class="font-['Inter'] text-xs sm:text-sm text-zinc-300 max-w-lg font-normal">
          {s.videoBanner.subtitle}
        </p>
      </div>
    </div>

  </div>

  {/*- Dark Charcoal Partner & Coalition Strip */}
  <div class="w-full bg-charcoal-dark text-white py-12 px-6 sm:px-10 lg:px-16 xl:px-20 border-y border-white/10">
    <div class="w-full max-w-screen-2xl mx-auto">
      <p class="text-center font-['Inter'] text-xs font-semibold uppercase tracking-widest text-zinc-400 mb-8">
        {s.partners.title}
      </p>

      {/*- Coalition Logos / Badges */}
      <div class="flex flex-wrap items-center justify-center gap-8 sm:gap-12 md:gap-16 opacity-85">
        {PARTNERS.map((partner) => (
          <div class="flex items-center gap-2.5 text-zinc-300 hover:text-white transition-colors">
            <span class="material-symbols-outlined text-2xl text-coral">{partner.icon}</span>
            <span class="font-['Cinzel'] text-xs sm:text-sm font-bold tracking-wider uppercase">
              {partner.name}
            </span>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
