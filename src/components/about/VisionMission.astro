---
//- Vision & Mission section with white background and distinct color-bordered cards
import { translations } from "../../locals/about/missionVision";
import { Target, Eye } from "@lucide/astro";

type Locale = "en" | "hi" | "fr";
const { local = "en" } = Astro.params ?? {};
const t = translations[local as Locale] || translations["en"];
---

<section class="bg-white py-20 px-4 md:px-8 border-b border-gray-100">
  <div class="max-w-7xl mx-auto grid md:grid-cols-2 gap-8">

    {/*- Mission Card */}
    <div class="animate-on-scroll scroll-left bg-white border-l-4 border-blue-800 border-t border-r border-b border-gray-200 rounded-2xl p-6 md:p-10 shadow-sm hover:shadow-md transition-shadow flex flex-col">
      <div class="flex items-center gap-4 mb-6">
        <div class="p-3.5 rounded-xl bg-blue-50 text-blue-800 flex items-center justify-center">
          <Target class="w-8 h-8" />
        </div>
        <h2 class="font-['Hanken_Grotesk'] text-2xl md:text-3xl font-bold text-blue-900">
          {t.mission.title}
        </h2>
      </div>
      <p class="font-['Inter'] text-gray-600 leading-relaxed text-base">
        {t.mission.description}
      </p>
    </div>

    {/*- Vision Card */}
    <div class="animate-on-scroll scroll-right bg-white border-l-4 border-green-700 border-t border-r border-b border-gray-200 rounded-2xl p-6 md:p-10 shadow-sm hover:shadow-md transition-shadow flex flex-col">
      <div class="flex items-center gap-4 mb-6">
        <div class="p-3.5 rounded-xl bg-green-50 text-green-700 flex items-center justify-center">
          <Eye class="w-8 h-8" />
        </div>
        <h2 class="font-['Hanken_Grotesk'] text-2xl md:text-3xl font-bold text-gray-900">
          {t.vision.title}
        </h2>
      </div>
      <p class="font-['Inter'] text-gray-600 leading-relaxed text-base">
        {t.vision.description}
      </p>
    </div>

  </div>
</section>
