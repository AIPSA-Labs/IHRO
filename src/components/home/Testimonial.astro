---
//- Authentic global voices and testimonial carousel with minimalist cards and clean typography

import { getStrings } from "../../constants/strings";

const { local = "en" } = Astro.params;
const s = getStrings(local);
---

<section class="py-24 md:py-32 bg-canvas overflow-hidden border-t border-border/80 w-full" id="global-voices">
  <div class="w-full max-w-screen-2xl mx-auto px-6 sm:px-10 lg:px-16 xl:px-20 mb-16 text-center">
    <h2 class="font-['Hanken_Grotesk'] text-3xl sm:text-4xl md:text-5xl font-bold tracking-tight text-justice-navy mb-4">
      {s.testimonials.title}
    </h2>
    <p class="font-['Inter'] text-base sm:text-lg text-on-surface-variant max-w-2xl mx-auto leading-relaxed">
      {s.testimonials.subtitle}
    </p>
  </div>

  {/*- Smooth Scrolling Testimonials Row */}
  <div class="relative w-full overflow-hidden">
    <div class="animate-scroll flex gap-6 px-4">
      
      {/*- Original Card Set */}
      <div class="flex gap-6 shrink-0">
        {s.testimonials.items.map((item) => (
          <div class="w-72 sm:w-96 bg-white p-6 sm:p-8 rounded-3xl border border-border/80 shadow-md flex flex-col justify-between shrink-0 hover:shadow-xl transition-shadow">
            <div>
              <div class="w-10 h-10 rounded-full bg-canvas-muted flex items-center justify-center text-royal-blue mb-6">
                <span class="material-symbols-outlined text-xl">format_quote</span>
              </div>
              <p class="font-['Inter'] text-sm sm:text-base text-justice-navy leading-relaxed mb-6 font-normal">
                "{item.quote}"
              </p>
            </div>
            
            <div class="pt-4 border-t border-border/60">
              <h4 class="font-['Hanken_Grotesk'] text-base font-bold text-justice-navy">
                {item.name}
              </h4>
              <p class="text-xs text-on-surface-variant mt-0.5">
                {item.role} • {item.location}
              </p>
            </div>
          </div>
        ))}
      </div>

      {/*- Duplicated Card Set for Seamless Continuous Loop */}
      <div aria-hidden="true" class="flex gap-6 shrink-0">
        {s.testimonials.items.map((item) => (
          <div class="w-72 sm:w-96 bg-white p-6 sm:p-8 rounded-3xl border border-border/80 shadow-md flex flex-col justify-between shrink-0 hover:shadow-xl transition-shadow">
            <div>
              <div class="w-10 h-10 rounded-full bg-canvas-muted flex items-center justify-center text-royal-blue mb-6">
                <span class="material-symbols-outlined text-xl">format_quote</span>
              </div>
              <p class="font-['Inter'] text-sm sm:text-base text-justice-navy leading-relaxed mb-6 font-normal">
                "{item.quote}"
              </p>
            </div>
            
            <div class="pt-4 border-t border-border/60">
              <h4 class="font-['Hanken_Grotesk'] text-base font-bold text-justice-navy">
                {item.name}
              </h4>
              <p class="text-xs text-on-surface-variant mt-0.5">
                {item.role} • {item.location}
              </p>
            </div>
          </div>
        ))}
      </div>

    </div>
  </div>
</section>
