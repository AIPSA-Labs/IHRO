---
//- Fullscreen slide-down navigation drawer with responsive editorial layout, language switcher, contact highlights, and quick links
import { getStrings } from "../../constants/strings";
import { supportedLocales } from "../../locals/languages";
import { CONFIG } from "../../constants/config";

const { local = "en" } = Astro.params;
const s = getStrings(local);

//- Extract clean sub-path so drawer language switcher keeps the current page
const pathname = Astro.url.pathname;
const cleanPath = pathname.replace(/^\/(en|hi|fr)/, '') || '';

const navItems = [
  { href: `/${local}/`, label: s.nav.home, icon: 'home', active: cleanPath === '' || cleanPath === '/' },
  { href: `/${local}/about`, label: s.nav.about, icon: 'info', active: cleanPath.startsWith('/about') },
  { href: `/${local}/#mission`, label: s.nav.mission, icon: 'flag', active: false },
  { href: `/${local}/about#policies`, label: s.nav.programs, icon: 'category', active: false },
  { href: `/${local}/about#leadership`, label: s.nav.presence, icon: 'public', active: false },
  { href: `/${local}/contact`, label: s.nav.contact, icon: 'mail', active: cleanPath.startsWith('/contact') },
];
---

<div class="fixed inset-0 z-50 transform -translate-y-full transition-transform duration-500 ease-out" id="drawer">
  <div class="absolute inset-0 bg-black/60 backdrop-blur-sm" onclick="toggleDrawer()"></div>
  <aside class="w-full h-full relative flex flex-col z-10 overflow-hidden bg-canvas">
    
    {/*- Drawer Header with Official Brand Identity */}
    <div class="flex justify-between items-center px-6 sm:px-10 py-5 border-b border-border/80 bg-white">
      <div class="flex items-center gap-3">
        <img src="/favicon.svg" alt={s.brand.name} class="h-9 w-9 object-contain" />
        <div class="flex flex-col">
          <span class="font-['Hanken_Grotesk'] text-lg font-bold text-justice-navy leading-none tracking-tight">
            {s.brand.name}
          </span>
          <span class="font-['Inter'] text-[11px] text-on-surface-variant font-medium mt-0.5">
            {s.brand.fullName}
          </span>
        </div>
      </div>
      <button
        class="w-10 h-10 flex items-center justify-center hover:bg-canvas-muted rounded-full transition-colors cursor-pointer text-justice-navy border border-border"
        onclick="toggleDrawer()"
        aria-label={s.nav.about}
      >
        <span class="material-symbols-outlined text-xl">close</span>
      </button>
    </div>

    {/*- Content Area */}
    <div class="flex flex-1 overflow-hidden">
      {/*- Desktop Side: Inspiring Humanitarian Image */}
      <div class="hidden md:flex w-7/12 h-full items-center justify-center p-12 bg-canvas">
        <div class="w-full h-full relative overflow-hidden rounded-3xl shadow-xl">
          <img
            src="https://images.pexels.com/photos/4827709/pexels-photo-4827709.jpeg"
            alt={s.brand.fullName}
            class="w-full h-full object-cover rounded-3xl"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/20 to-transparent flex flex-col justify-end p-8 text-white">
            <p class="font-['Hanken_Grotesk'] text-2xl font-bold leading-snug">{s.impact.quote1}</p>
            <p class="text-xs text-white/80 mt-2 font-['Inter']">— {s.impact.quote1Author}</p>
          </div>
        </div>
      </div>

      {/*- Mobile / Drawer Main Side: Modern Navigation */}
      <div class="w-full md:w-5/12 h-full flex flex-col justify-between px-6 sm:px-10 py-6 overflow-y-auto no-scrollbar bg-white">
        
        <div class="space-y-6">
          {/*- Navigation Links */}
          <nav class="flex flex-col gap-1.5">
            {navItems.map((item) => (
              <a
                href={item.href}
                onclick="toggleDrawer()"
                class={`flex items-center justify-between px-4 py-3 rounded-2xl transition-all group cursor-pointer ${
                  item.active
                    ? 'bg-royal-blue/10 text-royal-blue font-semibold'
                    : 'text-justice-navy hover:bg-canvas-muted hover:text-black font-medium'
                }`}
              >
                <div class="flex items-center gap-3.5">
                  <span class={`material-symbols-outlined text-xl transition-colors ${
                    item.active ? 'text-royal-blue' : 'text-on-surface-variant group-hover:text-royal-blue'
                  }`}>
                    {item.icon}
                  </span>
                  <span class="font-['Hanken_Grotesk'] text-base tracking-tight">
                    {item.label}
                  </span>
                </div>
                <span class="material-symbols-outlined text-base text-border group-hover:text-justice-navy transition-colors">
                  chevron_right
                </span>
              </a>
            ))}
          </nav>

          {/*- Segmented Language Control */}
          <div class="pt-4 border-t border-border/80">
            <span class="text-xs uppercase tracking-wider font-semibold text-on-surface-variant block mb-2 px-1">
              {s.nav.language}
            </span>
            <div class="grid grid-cols-3 gap-1.5 p-1 rounded-2xl bg-canvas-muted border border-border/80">
              {supportedLocales.map((loc) => (
                <a
                  href={`/${loc.code}${cleanPath}`}
                  class={`flex items-center justify-center py-2 rounded-xl text-xs font-semibold transition-all text-center ${
                    loc.code === local
                      ? 'bg-royal-blue text-white shadow-xs'
                      : 'text-justice-navy hover:bg-white hover:text-black'
                  }`}
                >
                  {loc.label}
                </a>
              ))}
            </div>
          </div>

          {/*- Quick Contact Info Strip */}
          <div class="p-4 rounded-2xl bg-canvas border border-border/80 space-y-2 text-xs font-['Inter'] text-on-surface-variant">
            <a href={`mailto:${CONFIG.CONTACT_INFO.EMAIL}`} class="flex items-center gap-2 hover:text-justice-navy transition-colors">
              <span class="material-symbols-outlined text-sm text-royal-blue">mail</span>
              <span>{CONFIG.CONTACT_INFO.EMAIL}</span>
            </a>
            <a href={`tel:${CONFIG.CONTACT_INFO.PHONE}`} class="flex items-center gap-2 hover:text-justice-navy transition-colors">
              <span class="material-symbols-outlined text-sm text-emerald-accent">call</span>
              <span>{CONFIG.CONTACT_INFO.PHONE_FORMATTED}</span>
            </a>
            <p class="flex items-center gap-2 text-on-surface-variant/80">
              <span class="material-symbols-outlined text-sm text-outline">location_on</span>
              <span>{CONFIG.CONTACT_INFO.ADDRESS}</span>
            </p>
          </div>
        </div>

        {/*- Drawer Footer CTA & Social Links */}
        <div class="pt-6 border-t border-border mt-6 space-y-4">
          <a
            href={`/${local}/contact?type=donate`}
            onclick="toggleDrawer()"
            class="w-full flex items-center justify-center gap-2 py-3.5 px-6 rounded-full bg-charcoal hover:bg-black text-white text-sm font-semibold transition-colors shadow-md cursor-pointer"
          >
            <span class="material-symbols-outlined text-base text-emerald-accent">volunteer_activism</span>
            <span>{s.nav.donateNow}</span>
          </a>

          {/*- Social Handles Row */}
          <div class="flex items-center justify-center gap-4 text-on-surface-variant text-xs">
            <a href={CONFIG.SOCIAL_URLS.LINKEDIN} target="_blank" rel="noopener noreferrer" class="hover:text-justice-navy transition-colors">
              LinkedIn
            </a>
            <span>•</span>
            <a href={CONFIG.SOCIAL_URLS.INSTAGRAM} target="_blank" rel="noopener noreferrer" class="hover:text-justice-navy transition-colors">
              Instagram
            </a>
            <span>•</span>
            <a href={CONFIG.SOCIAL_URLS.TWITTER} target="_blank" rel="noopener noreferrer" class="hover:text-justice-navy transition-colors">
              X (Twitter)
            </a>
          </div>
        </div>

      </div>
    </div>
  </aside>
</div>
