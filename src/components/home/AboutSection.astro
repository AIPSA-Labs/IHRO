---
//- Humanitarian impact and diplomatic chronicles section with archival framing, authoritative serif typography, and formal citation plaques
import { getStrings } from "../../constants/strings";

const { local = "en" } = Astro.params;
const s = getStrings(local);
---

<section class="relative pt-24 pb-28 md:pt-32 md:pb-36 bg-justice-navy text-white overflow-hidden w-full border-b border-white/10" id="about">
  
  <div class="relative w-full max-w-screen-2xl mx-auto px-6 sm:px-10 lg:px-16 xl:px-20 space-y-24 md:space-y-32">

    {/*- Story Row 1: Left Card, Right Text */}
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">
      
      {/*- Left Image Card with Overlaid Archival Plaque */}
      <div class="lg:col-span-6 relative flex justify-center lg:justify-start">
        <div class="relative max-w-lg w-full p-2 bg-white/5 border border-white/15 shadow-xl">
          <div class="relative w-full h-80 sm:h-96 overflow-hidden border border-white/10">
            <img
              src="https://images.pexels.com/photos/3184418/pexels-photo-3184418.jpeg"
              alt={s.impact.story1Title}
              class="w-full h-full object-cover"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent"></div>
          </div>

          {/*- Overlaid Archival Citation Plaque */}
          <div class="absolute bottom-5 left-5 right-5 sm:bottom-6 sm:left-6 sm:right-6 bg-justice-navy/95 border-l-2 border-honor-gold border-y border-r border-white/15 p-4 sm:p-5 shadow-lg">
            <p class="font-['Newsreader'] text-sm sm:text-base italic text-canvas leading-snug mb-2">
              "{s.impact.quote1}"
            </p>
            <span class="font-['Cinzel'] text-[10px] uppercase tracking-wider text-honor-gold font-bold block">
              — {s.impact.quote1Author}
            </span>
          </div>
        </div>
      </div>

      {/*- Right Content */}
      <div class="lg:col-span-6 flex flex-col justify-center">
        <h2 class="font-['Newsreader'] text-3xl sm:text-4xl md:text-5xl font-normal tracking-tight text-white leading-tight mb-6">
          {s.impact.story1Title}
        </h2>
        <p class="font-['Inter'] text-sm sm:text-base text-canvas-muted leading-relaxed mb-5 font-normal">
          {s.impact.story1Para1}
        </p>
        <p class="font-['Inter'] text-sm sm:text-base text-canvas-muted/80 leading-relaxed font-normal">
          {s.impact.story1Para2}
        </p>
      </div>

    </div>

    {/*- Story Row 2: Left Text, Right Card */}
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">
      
      {/*- Left Content */}
      <div class="lg:col-span-6 order-2 lg:order-1 flex flex-col justify-center">
        <h2 class="font-['Newsreader'] text-3xl sm:text-4xl md:text-5xl font-normal tracking-tight text-white leading-tight mb-6">
          {s.impact.story2Title}
        </h2>
        <p class="font-['Inter'] text-sm sm:text-base text-canvas-muted leading-relaxed mb-5 font-normal">
          {s.impact.story2Para1}
        </p>
        <p class="font-['Inter'] text-sm sm:text-base text-canvas-muted/80 leading-relaxed font-normal">
          {s.impact.story2Para2}
        </p>
      </div>

      {/*- Right Image Card with Overlaid Archival Plaque */}
      <div class="lg:col-span-6 order-1 lg:order-2 relative flex justify-center lg:justify-end">
        <div class="relative max-w-lg w-full p-2 bg-white/5 border border-white/15 shadow-xl">
          <div class="relative w-full h-80 sm:h-96 overflow-hidden border border-white/10">
            <img
              src="https://images.pexels.com/photos/8112199/pexels-photo-8112199.jpeg"
              alt={s.impact.story2Title}
              class="w-full h-full object-cover"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent"></div>
          </div>

          {/*- Overlaid Archival Citation Plaque */}
          <div class="absolute bottom-5 left-5 right-5 sm:bottom-6 sm:left-6 sm:right-6 bg-justice-navy/95 border-l-2 border-honor-gold border-y border-r border-white/15 p-4 sm:p-5 shadow-lg">
            <p class="font-['Newsreader'] text-sm sm:text-base italic text-canvas leading-snug mb-2">
              "{s.impact.quote2}"
            </p>
            <span class="font-['Cinzel'] text-[10px] uppercase tracking-wider text-honor-gold font-bold block">
              — {s.impact.quote2Author}
            </span>
          </div>
        </div>
      </div>

    </div>

  </div>
</section>
