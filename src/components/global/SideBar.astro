---
//- Sidebar drawer navigation with responsive split view and multicolor accents
import { supportedLocales } from "../../locals/languages";

type Locale = "en" | "hi" | "fr";
const { local = "en" } = Astro.params ?? {};
const currentPath = Astro.url.pathname;
const isHome = currentPath === `/${local}/` || currentPath === `/${local}`;
const isAbout = currentPath.startsWith(`/${local}/about`);
const isFaq = currentPath.startsWith(`/${local}/faq`);
const isContact = currentPath.startsWith(`/${local}/contact`);
---

{/*- Navigation Drawer (Full Width, Slide Down) */}
<div
  class="fixed inset-0 z-[60] transform -translate-y-full transition-transform duration-500 ease-[cubic-bezier(0.16,1,0.3,1)]"
  id="drawer"
>
  {/*- Backdrop */}
  <div class="absolute inset-0 bg-black/60" onclick="toggleDrawer()"></div>

  {/*- Drawer panel */}
  <aside class="w-full h-full relative flex flex-col z-10 overflow-hidden bg-white">

    {/*- Content area: image left + menu right */}
    <div class="flex flex-1 overflow-hidden">

      {/*- Left side: hero image with overlay (desktop only) */}
      <div class="hidden md:block md:w-3/4 h-full relative overflow-hidden">
        <img
          src="https://images.pexels.com/photos/4827709/pexels-photo-4827709.jpeg"
          alt="IHRO — Defending Human Rights"
          class="w-full h-full object-cover"
        />
        {/*- Blue gradient overlay */}
        <div class="absolute inset-0 bg-gradient-to-t from-blue-900 via-blue-900/60 to-transparent flex flex-col justify-end p-12">
          <span class="text-white font-['Hanken_Grotesk'] text-4xl font-bold leading-tight drop-shadow-lg">
            IHRO
          </span>
          <span class="text-blue-100 font-['Inter'] text-xl font-medium mt-2 drop-shadow-md">
            Defending Human Rights Worldwide
          </span>
          <div class="colored-bar h-1 w-32 mt-6 rounded-full overflow-hidden">
            <span></span><span></span><span></span><span></span><span></span>
          </div>
        </div>
      </div>

      {/*- Right side: menu panel */}
      <div class="w-full md:w-1/4 h-full flex flex-col overflow-y-auto no-scrollbar bg-white">

        {/*- Panel header: logo + close */}
        <div class="flex justify-between items-center px-8 py-5 border-b border-gray-100 animate-slide-down flex-shrink-0">
          <div class="flex items-center gap-3">
            <img src="/favicon.svg" alt="IHRO Logo" class="h-9 w-9 object-contain" />
            <span class="font-['Hanken_Grotesk'] text-2xl font-bold text-blue-900 tracking-tight">IHRO</span>
          </div>
          <button
            class="w-10 h-10 flex items-center justify-center hover:bg-gray-100 rounded-full transition-all duration-200 cursor-pointer"
            onclick="toggleDrawer()"
            aria-label="Close menu"
          >
            <span class="material-symbols-outlined text-gray-500">close</span>
          </button>
        </div>

        {/*- Nav links */}
        <nav class="flex flex-col px-6 pt-6 gap-1">
          <a
            href={`/${local}/`}
            onclick="toggleDrawer()"
            class={`menu-item border-l-2 pl-4 py-3 font-medium font-['Inter'] text-base transition-colors duration-200 rounded-r-lg ${isHome ? "border-blue-800 text-blue-900 font-semibold bg-blue-50/60" : "border-transparent text-gray-700 hover:border-blue-800 hover:text-blue-800 hover:bg-gray-50"}`}
            style="animation-delay: 0.08s"
          >
            Home
          </a>
          <a
            href={`/${local}/about`}
            onclick="toggleDrawer()"
            class={`menu-item border-l-2 pl-4 py-3 font-medium font-['Inter'] text-base transition-colors duration-200 rounded-r-lg ${isAbout ? "border-blue-800 text-blue-900 font-semibold bg-blue-50/60" : "border-transparent text-gray-700 hover:border-blue-800 hover:text-blue-800 hover:bg-gray-50"}`}
            style="animation-delay: 0.14s"
          >
            About
          </a>
          <a
            href={`/${local}/#programs`}
            onclick="toggleDrawer()"
            class="menu-item border-l-2 border-transparent hover:border-blue-800 pl-4 py-3 text-gray-700 hover:text-blue-800 hover:bg-gray-50 font-medium font-['Inter'] text-base transition-colors duration-200 rounded-r-lg"
            style="animation-delay: 0.20s"
          >
            Programs
          </a>
          <a
            href={`/${local}/#presence`}
            onclick="toggleDrawer()"
            class="menu-item border-l-2 border-transparent hover:border-blue-800 pl-4 py-3 text-gray-700 hover:text-blue-800 hover:bg-gray-50 font-medium font-['Inter'] text-base transition-colors duration-200 rounded-r-lg"
            style="animation-delay: 0.26s"
          >
            Presence
          </a>
          <a
            href={`/${local}/faq`}
            onclick="toggleDrawer()"
            class={`menu-item border-l-2 pl-4 py-3 font-medium font-['Inter'] text-base transition-colors duration-200 rounded-r-lg ${isFaq ? "border-blue-800 text-blue-900 font-semibold bg-blue-50/60" : "border-transparent text-gray-700 hover:border-blue-800 hover:text-blue-800 hover:bg-gray-50"}`}
            style="animation-delay: 0.32s"
          >
            FAQ
          </a>
          <a
            href={`/${local}/contact`}
            onclick="toggleDrawer()"
            class={`menu-item border-l-2 pl-4 py-3 font-medium font-['Inter'] text-base transition-colors duration-200 rounded-r-lg ${isContact ? "border-blue-800 text-blue-900 font-semibold bg-blue-50/60" : "border-transparent text-gray-700 hover:border-blue-800 hover:text-blue-800 hover:bg-gray-50"}`}
            style="animation-delay: 0.38s"
          >
            Contact
          </a>
        </nav>

        {/*- Language selector */}
        <div class="px-6 mt-6 menu-item" style="animation-delay: 0.44s">
          <div class="h-px bg-gray-100 mb-4"></div>
          <button
            onclick="toggleLang()"
            class="w-full flex items-center gap-3 pl-4 py-3 border-l-2 border-gray-200 hover:border-blue-800 text-gray-600 hover:text-blue-800 font-medium font-['Inter'] text-sm transition-all duration-200 cursor-pointer group"
          >
            <span class="material-symbols-outlined text-base leading-none">language</span>
            <span>Language</span>
            <span class="material-symbols-outlined text-base leading-none ml-auto transition-transform duration-300" id="langArrow">expand_more</span>
          </button>
          <div id="langOptions" class="hidden pl-4 pb-2 mt-1">
            <div class="flex flex-col gap-1">
              {supportedLocales.map((locale) => (
                <a
                  href={`/${locale.code}/`}
                  class="text-sm px-4 py-2 rounded-lg bg-gray-50 text-gray-600 font-medium hover:bg-blue-800 hover:text-white transition-colors duration-200 text-center font-['Inter']"
                >
                  {locale.label}
                </a>
              ))}
            </div>
          </div>
        </div>

        {/*- Bottom decorative strip */}
        <div class="mt-auto px-6 pb-6 pt-8 flex-shrink-0">
          <p class="text-gray-400 font-['Inter'] text-xs text-center tracking-widest uppercase mb-4">
            International Human Rights Organization
          </p>
          <div class="colored-bar h-1 w-full">
            <span></span><span></span><span></span><span></span><span></span>
          </div>
        </div>

      </div>
    </div>
  </aside>
</div>

<style>
  /*- Menu item entrance animation */
  .menu-item {
    opacity: 0;
    animation: slideInRight 0.5s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  :global(#drawer:not(.-translate-y-full)) .menu-item {
    opacity: 0;
    animation: slideInRight 0.5s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  @keyframes slideInRight {
    from {
      opacity: 0;
      transform: translateX(30px);
    }
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  @keyframes slideDown {
    from {
      opacity: 0;
      transform: translateY(-20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .animate-slide-down {
    animation: slideDown 0.4s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }
</style>

<script>
  //- Toggle language options in sidebar
  // @ts-ignore
  window.toggleLang = function() {
    const options = document.getElementById('langOptions');
    const arrow = document.getElementById('langArrow');
    if (options) {
      options.classList.toggle('hidden');
    }
    if (arrow) {
      arrow.classList.toggle('rotate-180');
    }
    if (options && !options.classList.contains('hidden')) {
      options.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    }
  };
</script>
