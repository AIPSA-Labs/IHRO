---
//- "Kindness, In Action" spotlight feature section with organic circular collage, dual-column checklist, and coral CTA

import { getStrings } from "../../constants/strings";

const { local = "en" } = Astro.params;
const s = getStrings(local);
---

<section class="py-20 md:py-28 bg-white text-zinc-900 border-b border-gray-100 overflow-hidden w-full" id="about">
  <div class="w-full max-w-screen-2xl mx-auto px-6 sm:px-10 lg:px-16 xl:px-20">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">

      {/*- Left Column: Organic Circular & Teardrop Image Collage */}
      <div class="lg:col-span-6 relative flex justify-center items-center animate-on-scroll scroll-scale">
        {/*- Decorative circular ring accent */}
        <div class="absolute w-72 h-72 sm:w-96 sm:h-96 rounded-full border-2 border-coral/30 -top-4 -left-4 pointer-events-none animate-float"></div>
        <div class="absolute w-60 h-60 sm:w-80 sm:h-80 rounded-full border border-coral/20 -bottom-6 -right-6 pointer-events-none"></div>

        {/*- Main Organic Circular Image Mask */}
        <div class="relative z-10 w-72 h-72 sm:w-96 sm:h-96 rounded-full overflow-hidden shadow-2xl border-4 border-white bg-gray-100">
          <img
            src="https://images.pexels.com/photos/6994982/pexels-photo-6994982.jpeg?auto=compress&cs=tinysrgb&w=900"
            alt={s.kindnessAction.title}
            class="w-full h-full object-cover"
            loading="lazy"
          />
        </div>

        {/*- Small Secondary Overlapping Circular Badge */}
        <div class="absolute -bottom-4 left-6 sm:left-12 z-20 w-24 h-24 sm:w-28 sm:h-28 rounded-full overflow-hidden shadow-lg border-3 border-white bg-coral">
          <img
            src="https://images.pexels.com/photos/3184418/pexels-photo-3184418.jpeg?auto=compress&cs=tinysrgb&w=400"
            alt="Aid in Action"
            class="w-full h-full object-cover"
            loading="lazy"
          />
        </div>
      </div>

      {/*- Right Column: Copy, 2-Column Checklist, and CTA */}
      <div class="lg:col-span-6 flex flex-col items-start text-left">
        
        {/*- Coral Tag */}
        <span class="text-coral text-xs sm:text-sm font-bold tracking-widest uppercase mb-3 animate-on-scroll">
          {s.kindnessAction.tag}
        </span>

        {/*- Title */}
        <h2 class="font-['Newsreader'] text-4xl sm:text-5xl font-bold tracking-tight text-zinc-900 leading-tight mb-5 animate-on-scroll delay-100">
          {s.kindnessAction.title}
        </h2>

        {/*- Description */}
        <p class="font-['Inter'] text-sm sm:text-base text-zinc-600 leading-relaxed mb-8 font-normal animate-on-scroll delay-150">
          {s.kindnessAction.description}
        </p>

        {/*- 2-Column Checklist */}
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 w-full mb-10 animate-on-scroll delay-200">
          {s.kindnessAction.checklist.map((item) => (
            <div class="flex items-center gap-3">
              <div class="w-6 h-6 rounded-full bg-coral/10 text-coral flex items-center justify-center shrink-0">
                <span class="material-symbols-outlined text-sm font-bold">check</span>
              </div>
              <span class="font-['Inter'] text-sm font-medium text-zinc-800">
                {item}
              </span>
            </div>
          ))}
        </div>

        {/*- Coral Pill Button */}
        <a
          href={`/${local}/about`}
          class="inline-flex items-center justify-center px-8 py-3.5 rounded-full bg-coral hover:bg-coral-hover text-white text-xs font-bold uppercase tracking-wider shadow-md transition-all cursor-pointer animate-on-scroll delay-300"
        >
          {s.kindnessAction.cta}
        </a>

      </div>

    </div>
  </div>
</section>
