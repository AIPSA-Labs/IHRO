---
//- Global Presence section with international offices, chapters, and network map
import { translations } from "../../locals/home/presence";
import digitalMap from "../../assets/digital-map.png";

type Locale = "en" | "hi" | "fr";
const { local = "en" } = Astro.params ?? {};
const t = translations[local as Locale] || translations["en"];
---

<section class="py-20 md:py-28 bg-white overflow-hidden border-b border-gray-100" id="presence">
  <div class="max-w-7xl mx-auto px-4 md:px-8">
    <div class="flex flex-col md:flex-row gap-10 md:gap-16 items-center">

      {/*- Left content column */}
      <div class="w-full md:w-1/2">

        {/*- Section heading */}
        <h2 class="animate-on-scroll scroll-left font-['Hanken_Grotesk'] text-3xl sm:text-4xl md:text-5xl font-bold text-blue-900 mb-6 md:mb-8 leading-tight">
          {t.title}
        </h2>

        <div class="space-y-8">

          {/*- International Offices group */}
          <div class="animate-on-scroll scroll-left delay-1">
            <h4 class="font-['Inter'] text-xs font-semibold text-blue-800 uppercase tracking-widest mb-3">
              {t.internationalTitle}
            </h4>
            <div class="flex flex-wrap gap-2.5">
              {t.internationalOffices.map((office) => (
                <span class="bg-blue-50 text-blue-900 border border-blue-100 rounded-lg px-3.5 py-1.5 text-sm font-['Inter'] font-medium">
                  {office.country}
                </span>
              ))}
            </div>
          </div>

          {/*- National Chapters group */}
          <div class="animate-on-scroll scroll-left delay-2">
            <h4 class="font-['Inter'] text-xs font-semibold text-green-800 uppercase tracking-widest mb-3">
              {t.nationalTitle}
            </h4>
            <div class="flex flex-wrap gap-2.5">
              {t.nationalChapters.map((chapter) => (
                <span class="bg-green-50 text-green-900 border border-green-100 rounded-lg px-3.5 py-1.5 text-sm font-['Inter'] font-medium">
                  {chapter}
                </span>
              ))}
            </div>
          </div>

          {/*- State Chapters group */}
          <div class="animate-on-scroll scroll-left delay-3">
            <h4 class="font-['Inter'] text-xs font-semibold text-purple-800 uppercase tracking-widest mb-3">
              {t.stateTitle}
            </h4>
            <div class="flex flex-wrap gap-2.5">
              {t.stateChapters.map((chapter) => (
                <span class="bg-gray-100 text-gray-800 border border-gray-200 rounded-lg px-3.5 py-1.5 text-sm font-['Inter'] font-medium">
                  {chapter}
                </span>
              ))}
            </div>
          </div>

        </div>
      </div>

      {/*- Right map column */}
      <div class="animate-on-scroll scroll-right w-full md:w-1/2">
        <div class="bg-blue-50/60 border border-blue-100 rounded-2xl p-4 sm:p-8 flex items-center justify-center shadow-sm">
          <img
            src={digitalMap.src}
            alt="Global Network Map"
            class="w-full h-full object-contain"
          />
        </div>
      </div>

    </div>
  </div>
</section>
