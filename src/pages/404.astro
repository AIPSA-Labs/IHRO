---
//- 404 Not Found error page
import Layout from "../layouts/Layout.astro";
---

<Layout>
  <section class="min-h-screen flex items-center justify-center py-20 px-4">
    <div class="text-center max-w-lg mx-auto">
      <div class="w-20 h-20 bg-blue-50 text-blue-800 rounded-2xl flex items-center justify-center mx-auto mb-6">
        <span class="material-symbols-outlined text-4xl">search_off</span>
      </div>
      <p class="font-['Hanken_Grotesk'] text-7xl font-extrabold text-blue-900 mb-2">404</p>
      <h1 class="font-['Hanken_Grotesk'] text-2xl md:text-3xl font-bold text-gray-900 mb-4">
        Page Not Found
      </h1>
      <p class="font-['Inter'] text-gray-600 text-base mb-8 leading-relaxed">
        The page you are looking for doesn't exist or has moved. Return to the home page to continue browsing.
      </p>
      <a
        href="/en/"
        class="inline-flex items-center gap-2 bg-blue-800 text-white font-semibold px-8 py-3.5 rounded-lg hover:bg-blue-900 transition-colors text-sm shadow-sm active:scale-95 cursor-pointer"
      >
        <span class="material-symbols-outlined text-base">home</span>
        <span>Return Home</span>
      </a>
    </div>
  </section>
</Layout>
