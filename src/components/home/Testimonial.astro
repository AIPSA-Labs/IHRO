---
//- Diplomatic endorsements and field testimonies with structured editorial quotation plaques

import { getStrings } from "../../constants/strings";

const { local = "en" } = Astro.params;
const s = getStrings(local);
---

<section class="py-24 md:py-32 bg-canvas overflow-hidden border-b border-border w-full" id="global-voices">
  <div class="w-full max-w-screen-2xl mx-auto px-6 sm:px-10 lg:px-16 xl:px-20 mb-16 text-center">
    <div class="inline-flex items-center gap-2.5 px-4 py-1 border border-border bg-white mb-4 shadow-2xs">
      <span class="w-1.5 h-1.5 bg-honor-gold rounded-full"></span>
      <span class="font-['Cinzel'] text-[10px] font-bold tracking-widest text-royal-blue uppercase">
        Diplomatic & Field Testimonies
      </span>
      <span class="w-1.5 h-1.5 bg-honor-gold rounded-full"></span>
    </div>

    <h2 class="font-['Newsreader'] text-3xl sm:text-4xl md:text-5xl font-medium tracking-tight text-justice-navy mb-5">
      {s.testimonials.title}
    </h2>
    <div class="w-12 h-0.5 bg-honor-gold mx-auto mb-6"></div>
    <p class="font-['Inter'] text-base text-on-surface-variant max-w-2xl mx-auto leading-relaxed">
      {s.testimonials.subtitle}
    </p>
  </div>

  {/*- Continuous Editorial Testimonials Carousel */}
  <div class="relative w-full overflow-hidden">
    <div class="animate-scroll flex gap-6 px-4">
      
      {/*- Original Card Set */}
      <div class="flex gap-6 shrink-0">
        {s.testimonials.items.map((item) => (
          <div class="w-80 sm:w-96 bg-white p-7 sm:p-8 border border-border rounded-none shadow-2xs flex flex-col justify-between shrink-0 hover:border-royal-blue transition-colors">
            <div>
              <div class="w-8 h-8 border border-border bg-canvas-muted flex items-center justify-center text-royal-blue mb-5">
                <span class="material-symbols-outlined text-base">format_quote</span>
              </div>
              <p class="font-['Newsreader'] text-base sm:text-lg italic text-justice-navy leading-relaxed mb-6 font-normal">
                "{item.quote}"
              </p>
            </div>
            
            <div class="pt-4 border-t border-border/80">
              <h4 class="font-['Cinzel'] text-xs font-bold uppercase tracking-wider text-justice-navy">
                {item.name}
              </h4>
              <p class="font-['Inter'] text-xs text-on-surface-variant mt-1">
                {item.role} · {item.location}
              </p>
            </div>
          </div>
        ))}
      </div>

      {/*- Duplicated Card Set for Seamless Continuous Loop */}
      <div aria-hidden="true" class="flex gap-6 shrink-0">
        {s.testimonials.items.map((item) => (
          <div class="w-80 sm:w-96 bg-white p-7 sm:p-8 border border-border rounded-none shadow-2xs flex flex-col justify-between shrink-0 hover:border-royal-blue transition-colors">
            <div>
              <div class="w-8 h-8 border border-border bg-canvas-muted flex items-center justify-center text-royal-blue mb-5">
                <span class="material-symbols-outlined text-base">format_quote</span>
              </div>
              <p class="font-['Newsreader'] text-base sm:text-lg italic text-justice-navy leading-relaxed mb-6 font-normal">
                "{item.quote}"
              </p>
            </div>
            
            <div class="pt-4 border-t border-border/80">
              <h4 class="font-['Cinzel'] text-xs font-bold uppercase tracking-wider text-justice-navy">
                {item.name}
              </h4>
              <p class="font-['Inter'] text-xs text-on-surface-variant mt-1">
                {item.role} · {item.location}
              </p>
            </div>
          </div>
        ))}
      </div>

    </div>
  </div>
</section>
